/*
 * Use of db (bit map)
 *  1 - disassemble instruction
 *  2 - show LD/ST addressw
 *  4 - info on many instructions
 *  8 - info on JT
 * 16 - info on VMM
 * 32 - info on MM,MS
 */
package my66000
{
    import my66000def;

//    type  Inst: _uint32;	// size of an instruction
//    type  Addr: _uint64;	// size of an address
//    type  Word: _uint64;	// size of a register
//    type  SWord: _int64;
    type  DWord: _uint128;	// FIXME - can't compile on 32-bit
    type  Half: _uint32;
    type  UImm:  _uint32;	// unsigned immediate values
    type  SImm:  _int32;	// signed immediate values
    // The following must be the same as the size field in a LD/ST instruction
    type  Width: (BYTE, HALF, WORD, QUAD);
    type  Faults: (NONE, EXIT, BKPT, SVC, OTHER);

    // The first 3 bits below must match those in ELF
    type MemFlags:
    {   x:	boolean;	// executable
        w:	boolean;	// writeable
	r:	boolean;	// readable
        a:	boolean;	// allocate memory
        l:	boolean;	// load from object file
    }: packed, lsb, bits(32);

    type Mem:
    {	adr:   _address;
	beg:   Addr;
	end:   Addr;
	flg:   MemFlags;
	read:  @_(adr: Addr, w: Width): Word;
	write: @_(adr: Addr, w: Width, data: Word);
	init:  @_();
    };
    type MemTab: []Mem;
    var memtab: @MemTab;
    var nmem: _uint;

    const breakpoint: Inst = 0xFFAA0000;	// FIXME
    const LR = 0;
    const FP = 30;
    const SP = 31;
    const PC = 32;	// not a general register

    var   reg:    [33]Word;	// includes PC
    // ThreadHeader word 0
    var   instpc: Addr;		// value of PC for this instruction
    var   nextpc: Addr;
    // ThreadHeader word 1, but not packed
    var   cbits:  _uint16 = 0;	// carry bits
    var   creg:   0..31;	// carry register
    var   roundm: 0..7;		// FP rounding mode
    var   flags:  0..0b11111;	// FP sticky exceptions
    var   vmode:  boolean = false; // in vector mode
    var   vreg:   0..31;	// vector loop register
    // ThreadHeader word 2
    var	  enabled:_uint64;
    // ThreadHeader word 3
    var	  raised: _uint64;
    // Other status
    var   shadow: _uint16;	// predication shadow bit map, 1 means skip
    var   pcnt:   _uint8 = 0;	// predication count, total
    var	  CI: boolean = false;	// carry in for this instruction
    var   CO: boolean = false;	// carry out for this instruction
    var   fault:  Faults = NONE;
    var   faultarg: UImm;
    var   rlast: _uint = 0;
    var   cycles: _uint = 0;
    var   setbp: boolean = false;
    var   stackstat:
    {     min:   Word;
	  max:   Word;
	  cycle: _uint;
    };


    type shiftT: (LSL, LSR, ASR, ROR);
    const shiftN: [shiftT]@[]_byte = { "LSL", "LSR", "ASR", "ROR" };


    proc Fault(s:@[]_byte, info: Word)
    {
	print bde, "\nFault cycle [d] at [08x] : [s] : [x]\n",
	    cycles, instpc, s, info;
	fault = OTHER;
    }

    proc Map(addr: Addr): boolean, _address
    {   var i: _uint;

	for i from 0 to nmem-1 do
	{   if addr >= memtab[i].beg && addr <= memtab[i].end then
	    {	addr -= memtab[i].beg;
		return true, memtab[i].adr@[addr];
	    }
	}
	return false, 0;
    }

    proc LoadBytes(addr: Word, data: @[]_byte, len: _uint): boolean
    {   var i: _uint;

        i = 0;
        while !(addr >= memtab[i].beg && addr+len <= memtab[i].end) do
	{  i += 1;
	   exit i >= nmem with return false;
	}
	addr -= memtab[i].beg;
	memtab[i].adr@[addr:len] = data[0:len];
	return true;
    }

    proc SysCall(nr: _uint, n: _uint)
    {	var ok: boolean;
	var addr: _address;
	var rv: _int;

	// using the /usr/include/asm/unistd64.h numbering
	if n
	is 0 then	// read
	{   ok, addr = Map(reg[Arg[2]]);
	    if ok then
	    {
		rv = sys.read(_int(reg[Arg[1]]), addr, _uint(reg[Arg[3]]));
		if rv < 0 then
		    print bde, "read error [d]\n", rv;
		reg[Arg[1]] = SWord(rv);
	    }
	}
	is 1 then	// write
	{   ok, addr = Map(reg[Arg[2]]);
	    if ok then
	    {
		rv = sys.write(_uint(reg[Arg[1]]), addr, _uint(reg[Arg[3]]));
		if rv < 0 then
		    print bde, "write error [d]\n", rv;
		reg[Arg[1]] = SWord(rv);
	    }
	}
	is 2 then	// open
	{   ok, addr = Map(reg[Arg[1]]);
	    if ok then
	    {
		rv = sys.open(addr, _uint(reg[Arg[2]]), _uint(reg[Arg[3]]));
		reg[Arg[1]] = SWord(rv);
	    }
	}
	is 3 then	// close
	{   sys.close(_int(reg[Arg[1]]));
	    reg[Arg[1]] = 0;	// FIXME sys.close
	}
	is 8 then	// lseek
	{   rv = sys.lseek(_int(reg[Arg[1]]), _uint(reg[Arg[2]]),
			   sys.whence_t(reg[Arg[3]]));
	    if rv < 0 then
		print bde, "lseek error [d]\n", rv;
	    reg[Arg[1]] = SWord(rv);
	}
	is 60 then	// exit
	{
	    fault = EXIT;
	}
	else
	    print bde, "** Unimplemented system call [d]\n", n;
    }

    proc Read(addr: Addr, w: Width): Word
    {   var i: _uint;
	var rv: Word;

//print bde, "Read  sz=[d] [[[x]] = ", _uint8(w), addr;
        i = rlast;
        while !(addr >= memtab[i].beg && addr <= memtab[i].end) do
	{   i += 1;
	    if i >= nmem then i = 0;
	   exit i == rlast with
	    {
		Fault("Read violation", addr);
		return 0;
	    }
	}
	rlast = i;
	if memtab[i].read == 0 then	// ordinary memory
	{   addr -= memtab[i].beg;
	    if w
            is BYTE then
		rv = memtab[i].adr@[addr];
	    is HALF then
		rv = (Word(memtab[i].adr@[addr+1]) << 8) | memtab[i].adr@[addr];
	    is WORD then
		rv = (Word(memtab[i].adr@[addr+3]) << 24) |
		     (Word(memtab[i].adr@[addr+2]) << 16) |
		     (Word(memtab[i].adr@[addr+1]) << 8)  |
		     memtab[i].adr@[addr];
	    else
		rv = _unpkle(memtab[i].adr@[addr:8]);
	}
	else
	    rv = memtab[i].read@(addr, w);
//print bde, "[x]\n", rv;
	return rv;
    }

    proc Write(addr: Addr, w: Width, v: Word)
    {   var i: _uint;

//print bde, "Write sz=[d] [[[x]] = [x]\n", _uint8(w) addr, v;
        i = rlast;
        while !(addr >= memtab[i].beg && addr <= memtab[i].end) do
	{   i += 1;
	    if i >= nmem then i = 0;
	   exit i == rlast with
	    {
		Fault("Write violation", addr);
		return;
	    }
	}
	if !memtab[i].flg.w && !setbp then
	{   Fault("Write not allowed", addr);
	    return;
	}
	rlast = i;
	if memtab[i].write == 0 then	// ordinary memory
	{   addr -= memtab[i].beg;
	    memtab[i].adr@[addr] = v;
	    if w
	    is BYTE then
		memtab[i].adr@[addr] = v;
	    is HALF then
	    	_packle(memtab[i].adr@[addr:2], _uint16(v));
	    is WORD then
	    	_packle(memtab[i].adr@[addr:4], _uint32(v));
	    else
	    	_packle(memtab[i].adr@[addr:8], v);
	}
	else
	    memtab[i].write@(addr, w, v);
    }

    proc SetBreakpoint(addr: Addr, n: _uint): Inst: inline
    {   var old: Inst;

	old = Read(addr, WORD);
	setbp = true;
	Write(addr, WORD, breakpoint | n);
	setbp = false;
	return old;
    }

    proc ClrBreakpoint(addr: Addr, inst: Inst):: inline
    {
	setbp = true;
	Write(addr, WORD, inst);
	setbp = false;
    }


    // Fake an interrupt
    proc Interrupt(vec: _uint)
    {
    }

    // Sign extend from a bit, leave as unsigned
    proc Sext(bit: _uint, x: Word): Word: inline
    {   var tmp: SWord;

	tmp = SWord(x);
	tmp = tmp << (Word?bits-1 - bit);
	tmp = tmp >> (Word?bits-1 - bit);
	return Word(tmp);
    }


    type CondCode: [CBits]boolean: packed;

alias bde as bdx;
import disinst;

    proc DoLDM(fm: _uint, to: _uint, adr: Word)
    {
	do
	{   reg[fm] = Read(adr, QUAD);
	    adr += 8;
	    fm += 1;  fm &= 0b11111;
	} while fm != to;
	reg[fm] = Read(adr, QUAD);
    }

    proc DoSTM(fm: _uint, to: _uint, adr: Word)
    {
	do
	{   Write(adr, QUAD, reg[fm]);
	    adr += 8;
	    fm += 1;  fm &= 0b11111;
	} while fm != to;
	Write(adr, QUAD, reg[fm]);
    }

    proc DoSRL(src: Word, w: _uint, o: _uint): Word
    {   var dst: Word;

	if w != 0 then	// FIXME - what does this mean with CI or CO
	{   dst = src << (64 -w -o);
	    dst = dst >> (64 -w);
	}
	else
	    dst = src >> o;
	if CI then
	    dst |= reg[creg] << (64 - o);
	if CO then
	    reg[creg] = src << (64 - o);
	return dst;
    }

    proc DoSRA(src: SWord, w: _uint, o: _uint): Word
    {   var dst: SWord;

	if w != 0 then
	{   dst = src << (64 -w -o);
	    dst = dst >> (64 -w);
	}
	else
	    dst = src >> o;
	return Word(dst);
    }

    proc DoSLL(src: Word, w: _uint, o: _uint): Word
    {   var dst: Word;

	if w != 0 then	// FIXME - what does this mean with CI or CO
	{   dst = src << (64 -w);
	    dst = dst >> (64 -w -o);
	}
	else
	    dst = src << o;
	if CI then
	    dst |= reg[creg] >> (64 - o);
	if CO then
	    reg[creg] = src >> (64 - o);
	return dst;
    }

    proc DoSLA(src: SWord, w: _uint, o: _uint): Word
    {
	if w != 0 then
	{   src = src << (64 -w);
	    src = src >> (64 -w -o);
	}
	else
	    src = src << o;
	// FIXME - check for overflow
	return Word(src);
    }

    proc DoROL(src: Word, w: _uint, o: _uint): Word
    {   var dst: Word;
	var tr, tl: Word;

	if w != 0 then
	{   tr = src << (64-w);		// shift to top
	    tr = tr  >> (64-o);
	    tl = src << (64-w+o);
	    tl = tl  >> (64-w);
	    dst = tl | tr;
	}
	else
	    dst = _rol(src, o);
	return dst;
    }

    proc DoROR(src: Word, w: _uint, o: _uint): Word
    {   var dst: Word;
	var tr, tl: Word;

	if w != 0 then
	{   tr = src << (64-o);
	    tr = tr  >> (64-w);
	    tl = src << (64-w);		// shift to top
	    tl = tl  >> (64-w+o);	// shift in place with zeros at top
	    dst = tl | tr;
	}
	else
	    dst = _ror(src, o);
	return dst;
    }

    // EXPERIMENTAL
    proc DoBITR(src: SWord, w: _uint, o: _uint): Word
    {   var dst: Word;
	var msk: Word;
	var n: _uint;

	assert w != 0;
	msk = (1 << w) - 1;
//print bde,"BITR w=[d] o=[d] msk=[x]\n", w, o, msk;
	if w == 0 then
	    dst = src;
	else
	{   dst = 0;
	    n = 64;
	    loop
	    {   dst |= src & msk;
	      exit n <= w;
		dst = dst << w;
		src = src >> w;
		n -= w;
	    }
	}
	if o != 0 then
	    dst = dst >> o;
	return dst;
    }

    proc DoINS(src1: Word, src2: Word, w: _uint, o: _uint): Word
    {   var mask: _uint64;

	if w != 0 then
	    mask = (~(~0 << w)) << o;
	else
	    mask = ~0 << o;
	src2 = src2 << o;
	return (src1 & ~mask) | (src2 & mask);
    }

    proc DoAdd(src1: Word, src2: Word): Word
    {	var sum: Word;

	sum = src1 + src2;
	if CI then
	    sum += reg[creg];
	if CO then
	{   if sum < src1 then
		reg[creg] = 1;
	    else
		reg[creg] = 0;
	}
	return sum;
    }

    proc DoMul(src1: Word, src2: Word): Word
    {
	if CO then	// double length result
	{   var td: DWord;
	    td = DWord(src1) * DWord(src2);
	    if CI then
		td += DWord(reg[creg]);
	    reg[creg] = Word(td >> 64);
	    return Word(td);
	}
	else
	{   var ts: Word;
	    ts = src1 * src2;
	    if CI then
		ts += reg[creg];
	    return ts;
	}
    }

    proc DoDiv(src1: Word, src2: Word): Word
    {
	if CI then	// double length dividend
	{   var tmp: DWord;
	    tmp = DWord(reg[creg] << 64) | DWord(src1);
	    if CO then
		reg[creg] = tmp % src2;
	    return Word(tmp / src2);
	}
	else
	{   if CO then
		reg[creg] = src1 % src2;
	    return src1 / src2;
	}
    }

    proc CheckCondition(cond: Conditions, src: Word): boolean
    {
	if cond
	is EQ0 then return src == 0;
	is NE0 then return src != 0;
	is GE0 then return SWord(src) >= 0;
	is GT0 then return SWord(src) >  0;
	is LE0 then return SWord(src) <= 0;
	is LT0 then return SWord(src) <  0;
	is A   then return true;
	is N   then return false;
	print bde, "Unimplemented condition [d]\n", _uint8(cond);
	return false;
    }

     /*
     * The comparison operation probably takes more code than gates
     */
    proc DoCompare(src1: Word, src2: Word): Word
    {   var cc: CondCode = {};

	cc[EQ]  = src1 == src2;
	cc[NEQ] = !(src1 == src2);
	cc[NE]  = src1 != src2;
	cc[NNE] = !(src1 != src2);
	cc[GE]  = SWord(src1) >= SWord(src2);
	cc[NGE] = !(SWord(src1) >= SWord(src2));
	cc[LT]  = SWord(src1) < SWord(src2);
	cc[NLT] = !(SWord(src1) < SWord(src2));
	cc[GT]  = SWord(src1) > SWord(src2);
	cc[NGT] = !(SWord(src1) > SWord(src2));
	cc[LE]  = SWord(src1) <= SWord(src2);
	cc[NLE] = !(SWord(src1) <= SWord(src2));
	cc[HS] = src1 >= src2;
	cc[LO] = src1 < src2;
	cc[HI] = src1 > src2;
	cc[LS] = src1 <= src2;
	cc[SIN] = SWord(src1) >= 0 && SWord(src1) <= SWord(src2);
	cc[FIN] = SWord(src1) >  0 && SWord(src1) <= SWord(src2);
	cc[CIN] = SWord(src1) >= 0 && SWord(src1) <  SWord(src2);
	cc[RIN] = SWord(src1) >  0 && SWord(src1) <  SWord(src2);
if db&4 != 0 then {
print bde, "DoCompare=[!x] : [!x] -> [!x]\n", src1, src2, Word(cc); }
	return Word(cc);
    }

    import float;


    proc DoDoubleCompare(s1: _float64, s2: _float64): Word
    {   var fcc: CondCode = {};	// init everything false
	var t1, t2: Word;
	var n1, n2: _int64;
	var sign: _uint;

	if s1.isNaN() then
	{   fcc[NaN] = true;
	    if (_uint64(s1) & 0x8_0000_0000_0000) != 0 then
		fcc[QNaN] = 1;
	    else
		fcc[SNaN] = 1;
	}
	elif !s2.isNaN() then	// ordered
	{   fcc[OR] = true;		// if s1 and s2 are ordered then they
	    n1 = _int64(_uint64(s1));	// are lexicographically ordered
	    n2 = _int64(_uint64(s2));	// so we can compare them as integers
	    // FIXME - should -0.0 == +0.0
	    if n1 == n2 then { fcc[EQ] = true; }
			else { fcc[NE] = true; }
	    if n1 >= n2 then { fcc[GE] = true; }
			else { fcc[LT] = true; }
	    if n1 <= n2 then { fcc[LE] = true; }
			else { fcc[GT] = true; }
	    if _abs(n1) >= _abs(n2) then fcc[HS] = true;
	    if _abs(n1) <  _abs(n2) then fcc[LO] = true;
	    if _abs(n1) >  _abs(n2) then fcc[HI] = true;
	    if _abs(n1) <= _abs(n2) then fcc[LS] = true;
	    sign = s1.getSign();
	    if s1.isInf() then
	    {	fcc[NI] = sign;
		fcc[PI] = sign^1;
	    }
	    elif s1.getExp() == 0 then
	    {	if s1.getFrac() == 0 then
		{   fcc[NZ] = sign;
		    fcc[PZ] = sign^1;
		}
		else
		{   fcc[ND] = sign;
		    fcc[PD] = sign^1;
		}
	    }
	    else
	    {	fcc[NN] = sign;
		fcc[PN] = sign^1;
	    }
	}
	t1 = Word(fcc);
	t2 = (~t1 & 0b1010000010101010101) << 1;// select bits to invert and shift
	t1 |= t2;
if db&4 != 0 then { print bde, "DoDoubleCompare=[!x]\n", t1; }
	return Word(t1);
    }

    proc DoSingleCompare(s1: _float32, s2: _float32): Word
    {   var fcc: CondCode = {};	// init everything false
	var t1, t2: Word;
	var n1, n2: _int32;
	var sign: _uint;

	if s1.isNaN() then
	{   fcc[NaN] = true;
	    if (_uint32(s1) & 0x40_0000) != 0 then
		fcc[QNaN] = 1;
	    else
		fcc[SNaN] = 1;
	}
	elif !s2.isNaN() then	// ordered
	{   fcc[OR] = true;		// if s1 and s2 are ordered then they
	    n1 = _int32(_uint32(s1));	// are lexicographically ordered
	    n2 = _int32(_uint32(s2));	// so we can compare them as integers
	    // FIXME - should -0.0 == +0.0
	    if s1 == s2 then { fcc[EQ] = true; }
			else { fcc[NE] = true; }
	    if s1 >= s2 then { fcc[GE] = true; }
			else { fcc[LT] = true; }
	    if s1 <= s2 then { fcc[LE] = true; }
			else { fcc[GT] = true; }
	    if _abs(n1) >= _abs(n2) then fcc[HS] = true;
	    if _abs(n1) <  _abs(n2) then fcc[LO] = true;
	    if _abs(n1) >  _abs(n2) then fcc[HI] = true;
	    if _abs(n1) <= _abs(n2) then fcc[LS] = true;
	    sign = s1.getSign();
	    if s1.isInf() then
	    {	fcc[NI] = sign;
		fcc[PI] = sign^1;
	    }
	    elif s1.getExp() == 0 then
	    {	if s1.getFrac() == 0 then
		{   fcc[NZ] = sign;
		    fcc[PZ] = sign^1;
		}
		else
		{   fcc[ND] = sign;
		    fcc[PD] = sign^1;
		}
	    }
	    else
	    {	fcc[NN] = sign;
		fcc[PN] = sign^1;
	    }
	}
	t1 = Word(fcc);
	t2 = (~t1 & 0b1010000010101010101) << 1;// select bits to invert and shift
	t1 |= t2;
if db&4 != 0 then { print bde, "DoDSingleCompare=[!x]\n", t1; }
	return Word(fcc);
    }

    import math;

    proc Transcend(src: Word, func: _uint, isf32: boolean, invert: boolean): Word
    {
if db&4 != 0 then { print bde, "trans [d]\n", func; }
	if isf32 then
	{   if invert then src ^= 0x8000_0000;
	    var flt: _float32 = _float32(_uint32(src));
	    const f1: _float32 = 1.0;
	    if func
	    is 0b00000 then flt = math.log2f(flt);	// log2
	    is 0b00001 then flt = math.logf(flt);	// ln
	    is 0b00010 then flt = math.log10f(flt);	// log10
	    is 0b00100 then flt = math.exp2f(flt);	// exp2
	    is 0b00101 then flt = math.expf(flt);	// exp
	    is 0b00110 then flt = math.exp10f(flt);	// exp10
	    is 0b01000 then flt = f1 / flt;		// rcp
	    is 0b01100 then flt = f1 / math.sqrtf(flt);	// rsqrt
	    is 0b01101 then flt = math.sqrtf(flt);	// sqrt
	    is 0b10000 then flt = math.log2f(flt+f1);	// log2(x+1)
	    is 0b10001 then flt = math.log1pf(flt);	// log(x+1)
	    is 0b10010 then flt = math.log10f(flt+f1);	// log10(x+1)
	    is 0b10100 then flt = math.exp2f(flt)-f1;	// exp2(x)-1
	    is 0b10101 then flt = math.expm1f(flt);	// exp(x)-1
	    is 0b10110 then flt = math.exp10f(flt)-f1;	// exp10(x)-1
	    is 0b11000 then flt = math.sinf(flt);	// sin
	    is 0b11001 then flt = math.cosf(flt);	// cos
	    is 0b11010 then flt = math.tanf(flt);	// tan
	    is 0b11100 then flt = math.asinf(flt);	// asin
	    is 0b11101 then flt = math.acosf(flt);	// acos
	    is 0b11110 then flt = math.atanf(flt);	// atan
	    return Word(_uint32(flt));
	}
	else	// fp64
 	{   if invert then src ^= 0x8000_0000_0000_0000;
	    var dbl: _float64 = _float64(src);
	    const d1: _float64 = 1.0;
	    if func
	    is 0b00000 then dbl = math.log2(dbl);	// log2
	    is 0b00001 then dbl = math.log(dbl);	// ln
	    is 0b00010 then dbl = math.log10(dbl);	// log10
	    is 0b00100 then dbl = math.exp2(dbl);	// exp2
	    is 0b00101 then dbl = math.exp(dbl);	// exp
	    is 0b00110 then dbl = math.exp10(dbl);	// exp10
	    is 0b01000 then dbl = d1 / dbl;		// rcp
	    is 0b01100 then dbl = d1 / math.sqrt(dbl);	// rsqrt
	    is 0b01101 then dbl = math.sqrt(dbl);	// sqrt
	    is 0b10000 then dbl = math.log2(dbl+d1);	// log2(x+1)
	    is 0b10001 then dbl = math.log1p(dbl);	// log(x+1)
	    is 0b10010 then dbl = math.log10(dbl+d1);	// log10(x+1)
	    is 0b10100 then dbl = math.exp2(dbl)-d1;	// exp2(x)-1
	    is 0b10101 then dbl = math.expm1(dbl);	// exp(x)-1
	    is 0b10110 then dbl = math.exp10(dbl)-d1;	// exp10(x)-1
	    is 0b11000 then dbl = math.sin(dbl);	// sin
	    is 0b11001 then dbl = math.cos(dbl);	// cos
	    is 0b11010 then dbl = math.tan(dbl);	// tan
	    is 0b11100 then dbl = math.asin(dbl);	// asin
	    is 0b11101 then dbl = math.acos(dbl);	// acos
	    is 0b11110 then dbl = math.atan(dbl);	// atan
	    return Word(dbl);
	}
    }

    type CvtType: (U, S, F, D);
    proc Convert(src: Word, fm: CvtType, to: CvtType): Word
    {
if db&4 != 0 then { print bde, "cvt src=[x]\n", src; }
	if to
	is U then	// unsigned result
	{   var unsigned: _uint64;
	    if fm
	    is D then unsigned = _uint64*(_float64(src));
	    is S then unsigned = _uint64(_int64(src));
	    is F then unsigned = _uint64*(_float32(_uint32(src)));
	    else print bde, "unimplemented cvt mode\n";
	    return Word(unsigned);
	}
	is S then	// signed result
	{   var signed: _int64;
	    if fm
	    is D then signed = _int64*(_float64(src));
	    is U then signed = _int64(_uint64(src));
	    is F then signed = _int64*(_float32(_uint32(src)));
	    else print bde, "unimplemented cvt mode\n";
	    return Word(signed);
	}
	is D then	// double result
	{   var double: _float64;
	    if fm
	    is U then double = _float64*(_uint64(src));
	    is F then double = _float32(_uint32(src));
	    is S then double = _float64*(_int64(src));
	    else print bde, "unimplemented cvt mode\n";
	    return Word(double);
	}
	is F then	// float result
	{   var float: _float32;
	    if fm
	    is U then float = _float32*(_uint64(src));
	    is D then float = _float64(src);
	    is S then float = _float32*(_int64(src));
	    else print bde, "unimplemented cvt mode\n";
	    return Word(_uint32(float));
	}
    }

    proc RoundD(src: Word, src2: Word): Word
    {
if db&4 != 0 then { print bde, "rnd src=[x] src2=[d]\n", src, src2; }
	return src;	// FIXME - temp
    }

    proc RoundF(src: Word, src2: Word): Word
    {
if db&4 != 0 then { print bde, "rndf src=[x] src2=[d]\n", src, src2; }
	return src;	// FIXME - temp
    }

    /*
     * Returns src1, src2, and nnxx
     *                         1---  src1 negated
     *                         -1--  src2 negated
     *                         --1-  src1 expanded from IMM5 (for FP)
     *                         ---1  src2 expanded from IMM5 (for FP)
     */
    proc get2Operands(inst: Inst) (src1:Word, src2:Word, nnxx: 0..0b1111)
    {   var op: OP2 = OP2(inst);
	var nnID: 0..0b1111;

	nnID = (inst>>5) & 0b1111;
	nnxx = nnID;
	src1 = reg[op.rs1];
	src2 = reg[op.rs2];
	if nnID			// nnxx
	is 0b0000,		// 0000 REG,REG
	   0b0100,		// 0100 REG,-REG
	   0b1000,		// 1000 REG,REG
	   0b1100 then		// 1100 -REG,-REG
	{
	}
	is 0b0001 then		// 0001 REG,+IMM5
	{   nnxx = 0b0001;
	    src2 = op.rs2;
	}
	is 0b0101 then		// 0010 +IMM5,REG
	{   nnxx = 0b0010;
	    src1 = op.rs1;
	}
	is 0b1001 then		// 0101 REG,-IMM5
	{   nnxx = 0b0101;
	    src2 = op.rs2;
	}
	is 0b1101 then		// 0110 +IMM5,-REG
	{   nnxx = 0b0110;
	    src1 = op.rs1;
	}
	is 0b0010,		// 0000 REG,IMM32
	   0b1010 then		// 1000 -REG,IMM32
	{   nnxx &= 0b1000;
	    src2 = Sext(31, Read(instpc+4, WORD));
	}
	is 0b0110,		// 0000 IMM32,REG
	   0b1110 then		// 0100 IMM32,-REG
	{   nnxx &= (nnxx>>1) & 0b0100;
	    src1 = Sext(31, Read(instpc+4, WORD));
	}
	is 0b0011,		// 0000 REG,IMM64
	   0b1011 then		// 1000 -REG,IMM64
	{   nnxx &= 0b1000;
	    src2 = Read(instpc+4, QUAD);
	}
	is 0b0111,		// 0000 IMM64,REG
	   0b1111 then		// 0100 IMM64,-REG
	{   nnxx &= (nnxx>>1) & 0b0100;
	    src1 = Read(instpc+4, QUAD);
	}
    }

    /*
     * The XOP1 integer 2 operand
     */
    proc Op2Int(inst: Inst)
    {   var op: OP2 = OP2(inst);
	var tmp, src1, src2: Word;
	var nnxx: 0..0b1111;
	var islogical: boolean;
	var minor: _uint;

	islogical = op.minor >= 0b1000;
	src1, src2, nnxx = get2Operands(inst);
	if (nnxx & 0b1000) != 0 then	// negate src1
	{   if islogical then
		src1 = ~src1;
	    else
		src1 = -src1;
	}
	if (nnxx & 0b0100) != 0 then	// negate src2
	{   if islogical then
		src2 = ~src2;
	    else
		src2 = -src2;
	}
	minor = (inst >> 9) & 0b1111_1_11;
if db&4 != 0 then {
print bde, "Op2 logical=[t] minor=[07b] src1=[016x] src2=[016x]\n",
islogical, minor, src1, src2;
}
	if minor
	// The 64-bit operations
	is 0b0001_0_00 then	// ADD
	    tmp = DoAdd(src1,src2);
	is 0b0001_1_00 then	// ADDS
	{   tmp = DoAdd(src1,src2);
	    // FIXME - check signed overflow if S-bit set
	}
	is 0b0010_0_00 then	// MUL
	    tmp = DoMul(src1,src2);
	is 0b0010_1_00 then	// MULS
	{   tmp = DoMul(src1,src2);
	    // FIXME - check signed
	}
	is 0b0011_0_00 then	// DIV
	    tmp = DoDiv(src1,src2);
	is 0b0011_1_00 then	// DIVS
	{   tmp = DoDiv(src1,src2);
	    // FIXME - check signed
	}
	is 0b0100_0_00 then	// CMP
	    tmp = DoCompare(src1,src2);
	is 0b0110_0_00 then	// MAX
	{   tmp = src1;	// assume now and fix later
	    if tmp < src2 then tmp = src2;
	}
	is 0b0110_1_00 then	// MAXS
	{   tmp = src1;	// assume now and fix later
	    if SWord(tmp) < SWord(src2) then tmp = src2;
	}
	is 0b0111_0_00 then	// MIN
	{   tmp = src1;	// assume now and fix later
	    if tmp > src2 then tmp = src2;
	}
	is 0b0111_1_00 then	// MINS
	{   tmp = src1;	// assume now and fix later
	    if SWord(tmp) > SWord(src2) then tmp = src2;
	}
	is 0b1000_0_00 then	// OR
	    tmp = src1 | src2;
	is 0b1001_0_00 then	// XOR
	    tmp = src1 ^ src2;
	is 0b1010_0_00 then	// AND
	    tmp = src1 & src2;

	// The 32-bit operations
	is 0b0001_0_01 then	// ADDW
	    tmp = Word(_uint32(DoAdd(src1,src2)));
	is 0b0001_1_01 then	// ADDSW
	{   tmp = Word(Sext(31, DoAdd(src1,src2)));
	    // FIXME - check signed overflow
	}
	is 0b0010_0_01 then	// MULW
	    tmp = Word(_uint32(DoMul(src1,src2)));
	is 0b0010_1_01 then	// MULSW
	{   tmp = Word(Sext(31, DoMul(src1,src2)));
	    // FIXME - check signed overflow
	}
	is 0b0011_0_01 then	// DIVW
	    tmp = Word(_uint32(DoDiv(src1,src2)));
	is 0b0011_1_01 then	// DIVSW
	{   tmp = Word(Sext(31, DoDiv(src1,src2)));
	    // FIXME - check signed overflow?
	}
	is 0b0100_0_01 then	// CMPW
	    tmp = DoCompare(_uint32(src1),_uint32(src2));
	is 0b0110_0_01 then	// MAXW
	    tmp = _max(_uint32(src1),_uint32(src2));
	is 0b0110_1_01 then	// MAXSW
	    tmp = Word(Sext(31, _max(_int32(src1),_int32(src2))));
	is 0b0111_0_01 then	// MINW
	    tmp = _min(_uint32(src1),_uint32(src2));
	is 0b0111_1_01 then	// MINSW
	    tmp = Word(Sext(31, _min(_int32(src1),_int32(src2))));
	is 0b1000_0_01 then	// ORW
	    tmp = Word(_uint32(src1 | src2));
	is 0b1001_0_01 then	// XORW
	    tmp = Word(_uint32(src1 ^ src2));
	is 0b1010_0_01 then	// ANDW
	    tmp = Word(_uint32(src1 & src2));
	else
	    Fault("Unimplemented instruction2", inst);
	reg[op.rd] = tmp;
    }

    // Convert IMM5 0..15.5 operand to floating point immediate
    proc FloatImm5(value: _uint, short: boolean): Word
    {
       if short then
           return Word(_uint32(_float32*(value)/2.0));
       else
           return Word(_float64*(value)/2.0);
    }

    /*
     * The XOP3 floating point 2 operand
     */
    proc Op2FP(inst: Inst)
    {   var op: OP2 = OP2(inst);
	var tmp, src1, src2: Word;
	var nnxx: 0..0b1111;
	var is32bit: boolean;
	var minor: _uint;

	is32bit = op.size != 0;		// FIXME 16-bit?
	src1, src2, nnxx = get2Operands(inst);
	// Expand IMM5
	if (nnxx & 0b0010) != 0 then	// expand src1
	    src1 = FloatImm5(src1, is32bit);
	if (nnxx & 0b0001) != 0 then	// expand src2
	    src2 = FloatImm5(src2, is32bit);
	if (nnxx & 0b1000) != 0 then	// negate src1
	    src1 ^= 0x8000_0000_0000_0000;	// flip sign bit
	if (nnxx & 0b0100) != 0 then	// negate src2
	    src2 ^= 0x8000_0000_0000_0000;	// flip sign bit

	minor = (inst >> 9) & 0b1111_1_11;
	if minor
	is 0b0001_0_00 then	// FADD/FSUB
	    tmp = Word(_float64(src1) + _float64(src2));
	is 0b0010_0_00 then	// FMUL
	    tmp = Word(_float64(src1) * _float64(src2));
	is 0b0011_0_00 then	// FDIV
	    tmp = Word(_float64(src1) / _float64(src2));
	is 0b0100_0_00 then	// FCMP
	    tmp = DoDoubleCompare(_float64(src1), _float64(src2));
	is 0b0110_0_00 then	// FMAX
	    tmp = Word(_max(_float64(src1), _float64(src2)));
	is 0b0111_0_00 then	// FMIN
	    tmp = Word(_min(_float64(src1), _float64(src2)));
	is 0b1000_0_00 then	// CSGN
	    tmp = (src1 & 0x7FFFFFFF_FFFF_FFFF) | (src2 & 0x80000000_00000000);
	is 0b1001_0_00 then	// EADD
	{	var dbl: _float64;
	    var old, new: _int;
	    var frac: _uint64;
	    dbl = _float64(src1);
	    if dbl.isNaN() || dbl.isInf() then
		tmp = src1;
	    else
	    {   old = dbl.getExp();
		new = old + src2;
		frac = dbl.getFrac();
		tmp = Word(float64Make(dbl.getSign(),_uint(new),frac));
	    }
	}
	is 0b1101_0_00 then	// HYPOT
	    Fault("HYPOT not yet implemented", inst);
	is 0b1110_0_00 then	// FPOW
	    Fault("POW not yet implemented", inst);
	is 0b1111_0_00 then	// FATAN2
	    Fault("ATAN2 not yet implemented", inst);

	is 0b0001_0_01 then	// FADDF/FSUBF
	    tmp = Word(_uint32(_float32(_uint32(src1)) + _float32(_uint32(src2))));
	is 0b0010_0_01 then	// FMULF
	    tmp = Word(_uint32(_float32(_uint32(src1)) * _float32(_uint32(src2))));
	is 0b0011_0_01 then	// FDIVF
	    tmp = Word(_uint32(_float32(_uint32(src1)) / _float32(_uint32(src2))));
	is 0b0100_0_01 then	// FCMPF
	    tmp = DoSingleCompare(_float32(_uint32(src1)), _float32(_uint32(src2)));
	is 0b0110_0_01 then	// FMAXF
	    tmp = Word(_uint32(_max(_float32(_uint32(src1)), _float32(_uint32(src2)))));
	is 0b0111_0_01 then	// FMINF
	    tmp = Word(_uint32(_min(_float32(_uint32(src1)), _float32(_uint32(src2)))));
	is 0b1000_0_01 then	// CSGNF
	    tmp = (src1 & 0x7FFF_FFFF) | (src2 & 0x8000_0000);
	is 0b1001_0_01 then	// EADDF
	    Fault("EADDF not yet implemented", inst);
	is 0b1101_0_01 then	// HYPOT
	    Fault("HYPOTF not yet implemented", inst);
	is 0b1110_0_01 then	// FPOW
	    Fault("POWF not yet implemented", inst);
	is 0b1111_0_01 then	// FATAN2
	    Fault("ATAN2F not yet implemented", inst);
	else
	    Fault("Unimplemented instruction2", inst);
	reg[op.rd] = tmp;
    }

    proc Op1(inst: Inst)
    {   var op: OP1 = OP1(inst);
	var src: Word;
	var dst: SWord;
	var inv: boolean;	// negate source

	if op.I == 0 then
	{   if op.D != 0 then	// IMM5
		src = Sext(4, op.rs2);
	    else
		src = reg[op.rs2];
	}
	else	// immediate used
	{   if op.D == 0 then	// 32-bit
		src = Sext(31,Read(reg[PC], WORD));
	    else		// 64-bit
		src = Read(instpc+4, QUAD);
	}
	inv = op.s2 != 0;
if db&4 != 0 then {
print bde, "Op1 minor=[04b] func=[05b] inv=[t] src=[016x]\n",
op.minor, op.func, inv, src;
}
	if op.minor
	is 0b0000 then					// HR
	{   var R: boolean = (op.size & 0b10) != 0;
	    var W: boolean = (op.size & 0b01) != 0;
	    if op.func
	    is 0 then		// IP (aka PC)
	    {   if R then		// R
		    reg[op.rd] = reg[PC];
		if W then		// W
		    nextpc = src;
	    }
//	    is 1 then		// Modes
	    is 2 then		// Active
	    {   if R then		// R
		    reg[op.rd] = raised;
		if W then		// W
		    raised = src;
	    }
	    is 3 then		// Enabled
	    {   if R then		// R
		    reg[op.rd] = enabled;
		if W then		// W
		    enabled = src;
	    }
	    is 4 then		// Shadow
	    {   if R then		// R
		    reg[op.rd] = shadow;
		if W then		// W
		    shadow = src;
	    }
	    is 5 then		// Flags
	    {   if R then		// R
		    reg[op.rd] = flags;
		if W then		// W
		    flags = src;
	    }
	    is 6 then		// Rounding Modes
	    {   if R then		// R
		    reg[op.rd] = roundm;
		if W then		// W
		    roundm = src;
		// FIXME - if rounding modes set, set them on host too
	    }
//	    is 7 then		// Why
	    else
	        Fault("Unimplemented HR function", inst);
	}
	is 0b0001 then					// VEC
	{   // The I bit should be 1, with a 32-bit immediate
	    vreg = op.rd;
if db&16 != 0 then { print bde, "vreg=[d]\n", vreg; }
	    reg[op.rd] = reg[PC];
	    vmode = true;
	}
	is 0b0110 then					// CLZ, ...
	{   if inv then
		src = ~src;
if db&4 != 0 then {
print bde, "\tsrc=[016x]\n", src;
}
	    if op.func
	    is 0b00000 then	// CLZ
	    {	if src == 0 then
		    reg[op.rd] = 64;
		else
		    reg[op.rd] = _clznz(src);
	    }
	    is 0b00001 then	// FL1
	    {	if src == 0 then
		    reg[op.rd] = 64;
		else
		    reg[op.rd] = 63 - _clznz(src);
	    }
	    is 0b00010, 0b00011 then	// FT1, CTZ
	    {	if src == 0 then
		    reg[op.rd] = 64;
		else
		    reg[op.rd] = _ctznz(src);
	    }
	    else
		Fault("Unimplemented instruction1", inst);
	}
	is 0b0111 then					// POP
	{   if inv then
		src = ~src;
	    reg[op.rd] = _pop(src);
	}
	is 0b1000 then					//
	{   if op.func
	    is 0b00000 then
	    {	if op.S == 0 then
		    reg[op.rd] = src;		// MOV
		else
		    reg[op.rd] = _abs(src);	// ABS
	    }
	    is 0b00001 then		// FABS
	    {	if op.size == 0 then
		    reg[op.rd] = src & 0x7FFF_FFFF_FFFF_FFFF;
		else
		    reg[op.rd] = src & 0xFFFF_FFFF_7FFF_FFFF;
	    }
	    is 0b00010 then		// EXPON
	    {   if op.size == 0 then
		{   var dbl: _float64;
		    if inv then src ^= 0x8000_0000_0000_0000;
		    dbl = _float64(src);
		    if dbl.isNaN() then
			dst = 0;
		    elif dbl.isNInf() then
			dst = _int64?min;
		    elif dbl.isPInf() then
			dst = _int64?max;
		    // FIXME - denorms
		    else
			dst = dbl.getTrueExp();
		}
		else
		{   var flt: _float32;
		    if inv then src ^= 0x8000_0000;
		    flt = _float32(_uint32(src));
		    if flt.isNaN() then
			dst = 0;
		    elif flt.isNInf() then
			dst = _int64?min;
		    elif flt.isPInf() then
			dst = _int64?max;
		    // FIXME - denorms
		    else
			dst = flt.getTrueExp();
		}
		reg[op.rd] = dst;
	    }
	    is 0b00011 then		// FRACT
	    {
		Fault("Unimplemented FRACT", inst);
	    }
	}
	else
	    Fault("Unimplemented instruction1", inst);
    }

    proc OpVec(inst: Inst)
    {   var op: OPVEC = OPVEC(inst);

	vreg = op.rd;
if db&16 != 0 then { print bde, "vreg=[d]\n", vreg; }
	reg[vreg] = nextpc;
	vmode = true;
    }

    proc DoLoopCompare(op: OPLOOP, inc: Word, cmp: Word): boolean
    {   var cnd: _uint;
	const CMP: [10][2]_byte =
	{'EQ','NE','HS','LO','HI','LS','GE','LT','GT','LE'};

	cnd = op.kcnd % 11;
if db&16 != 0 then {
print bde, " compare [d] [c][c] [d]\n", inc, CMP[cnd][0], CMP[cnd][1], cmp;
}
	if cnd
	is 0 then return inc == cmp;
	is 1 then return inc != cmp;
	is 2 then return inc >= cmp;
	is 3 then return inc < cmp;
	is 4 then return inc > cmp;
	is 5 then return inc <= cmp;
	is 6 then return SWord(inc) >= SWord(cmp);
	is 7 then return SWord(inc) < SWord(cmp);
	is 8 then return SWord(inc) > SWord(cmp);
	is 9 then return SWord(inc) <= SWord(cmp);
	return false;
    }


    /*
	nnId   Rinc  Rcmp
	0000   REG   REG
	0001   REG   IMM5
	0010   REG   IMM32
	0011   REG   IMM64
	0101   IMM5  REG
	0110   IMM32 REG
	0111   IMM64 REG
	1101   IMM5  IMM5     different from 2OP
	1110   IMM16 IMM16    split IMM32
	1111   IMM32 IMM32    split IMM64
     */
    proc GetLoopOperands(inst: Inst)
			(increg:boolean, cmpreg: boolean, inc:Word, cmp:Word)
    {   var op: OPLOOP = OPLOOP(inst);
	var tmp: Word;
	var nnID: 0..0b1111;

	nnID = (inst>>5) & 0b1111;
	if op.I != 0 then
	{   if op.D != 0 then
		tmp = Read(instpc+4, QUAD);
	    else
		tmp = Read(instpc+4, WORD);
	}
	inc = reg[op.rs1];
	cmp = reg[op.rs2];
	increg = false;
	cmpreg = false;
	if nnID
	is 0b0000 then
	{   increg = true;
	    cmpreg = true;
	}
	is 0b0001 then
	{   increg = true;
	    cmp = Sext(4, op.rs2);
	}
	is 0b0010, 0b0011 then
	{   increg = true;
	    cmp = tmp;
	}
	is 0b0101 then
	{   inc = Sext(4, op.rs1);
	    cmpreg = true;
	}
	is 0b0110, 0b0111 then
	{   inc = tmp;
	    cmpreg = true;
	}
	is 0b1100 then
	{   inc = Sext(4, op.rs1);
	    cmp = Sext(4, op.rs2);
	}
	is 0b1110 then
	{   cmp = Sext(15, _uint16(tmp));
	    inc = Sext(15, _uint16(tmp>>16));
	}
	is 0b1111 then
	{   cmp = Sext(31, _uint32(tmp));
	    inc = Sext(31, _uint32(tmp>>16));
	}
    }

    proc OpLoop(inst: Inst)
    {   var op: OPLOOP = OPLOOP(inst);
	var inc, cmp: Word;
	var increg, cmpreg: boolean;
	var kind: _uint;
	var continue: boolean = true;

	increg, cmpreg, inc, cmp = GetLoopOperands(inst);
	kind = (op.kcnd / 11) + 1;
	if kind
	is 1 then
	{   // add Rloop,Rloop,INC; cmp Rt,Rloop,CMP; bcnd Rt,VEC+4
if db&16 != 0 then {
print bde, "loop1 loop=[d], inc=[d], cmp=[d]", reg[op.rd], inc, cmp;
}
	    reg[op.rd] += inc;
	    if cmpreg then cmp = reg[op.rs2];	// in case rd == rs2
	    continue = DoLoopCompare(op, reg[op.rd], cmp);
	}
	is 2 then
	{   // pne0 INC,TTT; add Rloop,Rloop,#1; cmp Rt,Rloop,CMP; bcnd Rt,VEC+4
if db&16 != 0 then {
print bde, "loop2 loop=[d], inc=[d], cmp=[d]", reg[op.rd], inc, cmp;
}
	    if inc == 0 then
		continue = false;
	    else
	    {	reg[op.rd] += 1;
		if cmpreg then cmp = reg[op.rs2];	// in case rd == rs2
		continue = DoLoopCompare(op, reg[op.rd], cmp);
	    }
	}
	is 3 then
	{   // add Rloop,Rloop,#1; cmp Rt,INC,CMP; bcnd	Rt,VEC+4
if db&16 != 0 then {
print bde, "loop3 loop=[d], inc=[d], cmp=[d]", reg[op.rd], inc, cmp;
}
	    reg[op.rd] += 1;
	    if cmpreg then cmp = reg[op.rs2];	// in case rd == rs2
	    if increg then inc = reg[op.rs1];	// in case rd == rs1
	    continue = DoLoopCompare(op, inc, cmp);
	}
	vmode = continue;
	if continue then
	    nextpc = reg[vreg];
    }

    proc DoFmacD(op: OP3)
    {   var src2, src3, tmp: _float64;

	src2 = _float64(reg[op.rs2]);
	src3 = _float64(reg[op.rs3]);
	if op.I != 0 then	// has immediate
	{   if op.s1 != 0 then	// 64-bit
	    {   tmp = _float64(Read(reg[PC], QUAD));
	    }
	    else		// 32-bit, convert to 64
	    {   tmp = _float32(_uint32(Read(reg[PC], WORD)));
	    }
	    if op.s2 != 0 then
		src2 = tmp;
	    else
		src3 = tmp;
	}
	else
	{   if op.s1 != 0 then
		src2 = -src2;
	    if op.s2 != 0 then
		src3 = -src3;
	}
	reg[op.rd] = Word((_float64(reg[op.rs1]) * src2) + src3);
    }

    proc DoFmacF(op: OP3)
    {   var src2, src3, tmp: _float32;

	src2 = _float32(_uint32(reg[op.rs2]));
	src3 = _float32(_uint32(reg[op.rs3]));
	if op.I != 0 then	// has immediate
	{   if op.s1 != 0 then	// 64-bit weird
	    {   tmp = _float32*(_float64(Read(reg[PC], QUAD)));
	    }
	    else		// 32-bit
	    {   tmp = _float32(_uint32(Read(reg[PC], WORD)));
	    }
	    if op.s2 != 0 then
		src2 = tmp;
	    else
		src3 = tmp;
	}
	else
	{   if op.s1 != 0 then
		src2 = -src2;
	    if op.s2 != 0 then
		src3 = -src3;
	}
	reg[op.rd] = Word(_uint32((_float32(_uint32(reg[op.rs1])) * src2) + src3));
    }

    proc OpMux(inst: Inst)
    {   var op: OP3 = OP3(inst);
	var src1, src2: Word;
	var nnxx: 0..0b1111;

	src1, src2, nnxx = get2Operands(inst);
	if (nnxx & 0b1000) != 0 then	// negate src1
	    src1 = -src1;
	if (nnxx & 0b0100) != 0 then	// negate src2
	    src2 = -src2;
if db&4 != 0 then {
print bde, "CMOV [04b] - [d] ? [x] : [x]\n", nnxx, reg[op.rs3], src1, src2;
}
	if reg[op.rs3] != 0 then
	    reg[op.rd] = src1;
	else
	    reg[op.rd] = src2;
    }

    proc OpIns(inst: Inst)
    {   var op: OP3 = OP3(inst);
	var w,o: _uint;
	var tmp3: Word;

	// FIXME immediates
	    if op.I != 0 then	// has immediate
	    {	if op.s1 != 0 then	// 64-bit (never used?)
		{   tmp3 = Read(reg[PC], QUAD);
		}
		else			// 32-bit FIXME - unsigned?
		{   tmp3 = Read(reg[PC], WORD);
		}
		w = (tmp3 >> 6) & 0b111111;
		o = tmp3 & 0b111111;
	    }
	    else
	    {	tmp3 = reg[op.rs3];
		w = (tmp3 >> 32) & 0b111111;
	    }
	    o = tmp3 & 0b111111;
	    reg[op.rd] = DoINS(reg[op.rs1], reg[op.rs2], w, o);
    }

    proc OpMac(inst: Inst)
    {   var op: OP3 = OP3(inst);
	if op.size
	is 0b00 then DoFmacD(op);	// FMAC
	is 0b01 then DoFmacF(op);	// FMACF
	else
	    Fault("Unimplemented instruction3", inst);
    }

    proc UpdateShadow(take: boolean, inst: Inst)
    {	var op: OPPC = OPPC(inst);	// or OPPB
	var mask: _uint16;
	var new: _uint16;
	var cnt: _uint8;

	cnt  = op.else + op.then;
	new  = ((1 << op.else) - 1) << op.then;
	if !take then new = ~new;
	mask = 0xFFFF >> (16 - cnt);
if db&128 != 0 then {
print bde, "UpdateShadow: ip=[x] take=[t], cnt=[d], new=[16b] mask=[16b]\n",
reg[PC], take, cnt, new, mask;
}
	new &= mask;
	if pcnt == 0 then
	    pcnt = cnt;
	else
	{   // in shadow, pcnt remains the same and not increase
	    if cnt > pcnt then
	    {	// Shadow must not increase FIXME - a fault?
print bde, "Shadow bad cnt: old=[d] new=[d] at ip=[x]\n", pcnt, cnt, reg[PC];
		return;
	    }
	}
if db&128 != 0 then {
print bde, "old=[16b] this=[16b]", shadow, new;
}
	shadow = new | (shadow & ~mask);
if db&128 != 0 then {
print bde, " new=[16b] pcnt=[d]\n", shadow, pcnt;
}
    }

    proc DoPb1(inst: Inst, src: Word)
    {	var opb: OPPB = OPPB(inst);
	var n: _uint;

	n = opb.bit;
	UpdateShadow(reg[opb.rs1] & (1 << n) != 0, inst);
    }

    proc DoPcnd(inst: Inst, src: Word)
    {	var opc: OPPC = OPPC(inst);

	UpdateShadow(CheckCondition(Conditions(opc.cond), reg[opc.rs1]), inst);
    }

    proc OpPred(inst: Inst)
    {   var opc: OPPC = OPPC(inst);	// assume pred on condition
	var src: Word;

	src = reg[opc.rs1];
	if opc.minor
	is 0b0000 then DoPb1(inst, src);
	is 0b0001 then DoPcnd(inst, src);
	else
	    Fault("Unimplemented pred instruction", inst);
    }

    proc OpPredShf(inst: Inst)
    {	var op: OPSHFR = OPSHFR(inst);
	var src: Word;

	src = reg[op.rs1];
if db&4 != 0 then {
if op.minor != 0b0000 then
print bde, "Shift1 op=[04b] o=[d] w=[d] src=[x]\n", op.minor, op.o, 0, src;
}
	if op.minor
	is 0b0000 then DoPb1(inst, src);
	is 0b0100 then reg[op.rd] = DoBITR(src, 0, op.o);	// EXPERIMENTAL
	is 0b1000 then reg[op.rd] = DoSRL(src, 0, op.o);
	is 0b1001 then reg[op.rd] = DoSRA(SWord(src), 0, op.o);
	is 0b1010 then reg[op.rd] = DoSLL(src, 0, op.o);
	is 0b1011 then reg[op.rd] = DoSLA(SWord(src), 0, op.o);
	is 0b1100 then reg[op.rd] = DoROR(src, 0, op.o);
	is 0b1101 then reg[op.rd] = DoROL(src, 0, op.o);
	else
	    Fault("Unimplemented shift instruction", inst);
    }

    proc OpShfR(inst: Inst)
    {	var op: OP2 = OP2(inst);
	var src1, src2: Word;
	var nnxx: 0..0b1111;
	var offset, width: _uint;

	src1, src2, nnxx = get2Operands(inst);
	if (nnxx & 0b1000) != 0 then	// negate src1
	    src1 = -src1;
	if (nnxx & 0b0100) != 0 then	// negate src2
	    src2 = -src2;
	offset = _uint32(src2);		// lo bits
	width  = _uint32(src2 >> 32);	// hi bits
if db&4 != 0 then {
print bde, "Shift2 op=[04b] o=[d] w=[d] src=[x]\n",
	    op.minor, offset, width, src1;
}
	if op.minor
	is 0b1000 then reg[op.rd] = DoSRL(src1, width, offset);
	is 0b1001 then reg[op.rd] = DoSRA(SWord(src1), width, offset);
	is 0b1010 then reg[op.rd] = DoSLL(src1, width, offset);
	is 0b1011 then reg[op.rd] = DoSLA(SWord(src1), width, offset);
	is 0b1100 then reg[op.rd] = DoROR(src1, width, offset);
	is 0b1101 then reg[op.rd] = DoROL(src1, width, offset);
	else
	    Fault("Unimplemented shift instruction", inst);
    }

    proc OpShfOW(inst: Inst)
    {	var op: OPSHF = OPSHF(inst);
	var src: Word;

	src = reg[op.rs1];
if db&4 != 0 then {
print bde, "Shift3 op=[04b] o=[d] w=[d] src=[x]\n", op.minor, op.o, op.w, src;
}
	if op.minor
	is 0b1000 then reg[op.rd] = DoSRL(src, op.w, op.o);
	is 0b1001 then reg[op.rd] = DoSRA(SWord(src), op.w, op.o);
	is 0b1010 then reg[op.rd] = DoSLL(src, op.w, op.o);
	is 0b1011 then reg[op.rd] = DoSLA(SWord(src), op.w, op.o);
	is 0b1100 then reg[op.rd] = DoROR(src, op.w, op.o);
	is 0b1101 then reg[op.rd] = DoROL(src, op.w, op.o);
	else
	    Fault("Unimplemented shift instruction", inst);
    }

    proc OpMov(inst: Inst)
    {	var op: OPIMM = OPIMM(inst);
	var tmp: Word;
	var fp16: _uint64;

	if (op.rs1 >> 3)
	is 3	then tmp = Word(_int64(op.imm));  // extend signed 16-bits
	is 2	then tmp = Word(_uint64(op.imm)); // extend unsigned 16-bits
	is 1	then // extend FP16 to FP32
	{   fp16 = _uint64(op.imm);
	    tmp =  (fp16 & 0xC000) << 16;
	    tmp |= (fp16 & 0x3FFF) << 13;
	}
	is 0	then // extend FP16 to FP64
	{   fp16 = _uint64(op.imm);
	    tmp =  (fp16 & 0xC000) << 48;
	    tmp |= (fp16 & 0x3FFF) << 42;
	}
	reg[op.rd] = tmp;
    }

    proc OpImm(inst: Inst)
    {	var op: OPIMM = OPIMM(inst);
	var tmp, src: Word;

	tmp = Word(_int64(op.imm));	// extend signed 16-bits
	src = reg[op.rs1];
	if op.major & 0b1111
	is 0b0001 then tmp = DoAdd(src,tmp);	// add
	is 0b0010 then tmp = DoMul(src,tmp);	// mul
	is 0b0011 then tmp = DoDiv(src,tmp);	// div
	is 0b0100 then tmp = DoCompare(src,tmp);// cmp
	is 0b1000 then tmp = src | tmp;		// or
	is 0b1001 then tmp = src ^ tmp;		// xor
	is 0b1010 then tmp = src & tmp;		// and
	reg[op.rd] = tmp;
    }

    proc DoMM(inst: Inst)
    {   var op: OP2 = OP2(inst);
	var to, fm: Addr;
	var cnt: Word;

	to = reg[op.rs1];
	fm = reg[op.rd];
	if op.I != 0 then	// we have a following immediate
	{   if op.D != 0 then	// 64-bit immediate
		cnt = Read(instpc+4,, QUAD);
	    else		// 32-bit signed immediate
		cnt = Sext(31,Read(instpc+4, WORD));
	}
	else if op.D != 0 then
	    cnt = op.rs2;
	else
	    cnt = reg[op.rs2];
if db&32 != 0 then {
print bde, "MM @[x] fm=[x] to=[x] cnt=[d]\n", instpc, fm, to, cnt; }
	while cnt != 0 do
	{   Write(to, BYTE, Read(fm, BYTE));
	    if fault != NONE then
		return;
	    to += 1;
	    fm += 1;
	    cnt -= 1;
	}
    }

    proc DoMS(inst: Inst, val: Word)
    {   var op: OP2 = OP2(inst);
	var to: Addr;
	var cnt: Word;

	val&= 0xFF;
	to = reg[op.rs1];
	if op.I != 0 then	// we have a following immediate
	{   if op.D != 0 then	// 64-bit immediate
		cnt = Read(instpc+4,, QUAD);
	    else		// 32-bit signed immediate
		cnt = Sext(31,Read(instpc+4, WORD));
	}
	else if op.D != 0 then
	    cnt = op.rs2;
	else
	    cnt = reg[op.rs2];
if db&32 != 0 then {
print bde, "MS @[x] nnID=[d][d][d][d] val=[x] to=[x] cnt=[d]\n",
instpc, op.s1, op.s2, op.I, op.D, val, to, cnt; }
	while cnt != 0 do
	{   Write(to, BYTE, val);
	    if fault != NONE then
		return;
	    to += 1;
	    cnt -= 1;
	}
    }


    proc OpMem(inst: Inst)
    {   var op: OPMEM = OPMEM(inst);
	var minor: _uint;
	var base, disp, adr, inx, imm: Word;
	var tmp: Word;
	var width: Width;
	const size2width: [4]Width = { QUAD, WORD, HALF, BYTE };

	disp = 0;		// displacement, if any
	if op.I != 0 then	// we have a following dispacement
	{   if op.D != 0 then	// 64-bit immediate
		disp = Read(instpc+4,, QUAD);
	    else		// 32-bit signed immediate
		disp = Sext(31,Read(instpc+4, WORD));
	}
	if op.rb == 0 then	// base
	    base = instpc;
	else
	    base = reg[op.rb];
	inx = 0;
	if op.ri != 0 then	// Get indexing, maybe nullified later
	{   inx = reg[op.ri];
	    if op.sc != 0 then inx = inx << op.sc;
	}
	tmp = reg[op.rd];	// Get store data, maybe changed later
	adr = base + inx + disp;
	width = size2width[op.size];
if db&2 != 0 then
print bde,
"OpMem minor=[04b] L=[d] size=[d] base=[x] inx=[x] disp=[x] adr=[x]\n",
op.minor, op.L, op.size, base, inx, disp, adr;
	// FIXME - atomics
	if op.minor
	is 0b0000 then			// LDD LDU{WHB}
	    reg[op.rd] = Read(adr, width);
	is 0b0001 then			// LA, LDS{WHB}
	{   if op.size == 0 then	// LA
		reg[op.rd] = adr;
	    else
		reg[op.rd] = Sext(31,Read(adr, width));
	}
	is 0b0010 then			// STD ST{WHB}
	    Write(adr, width, tmp);
	is 0b0110 then			// CALX/JMPX
	{   nextpc = Read(adr, QUAD);
	    if op.rd == 0 then
		reg[LR] = reg[PC];
	}
	is 0b0111 then			// CALA
	{   nextpc = adr;
	    reg[LR] = reg[PC];
	}
	is 0b1010 then			// LDM
	{   if op.L ==  0 then
		DoLDM(op.rd, op.ri, adr);
	    else
		DoMM(inst);		// FIXME - op.size == 3
	}
	is 0b1011 then			// STM
	{   if op.L ==  0 then
		DoSTM(op.rd, op.ri, adr);
	    else
		DoMS(inst, reg[op.rd]);	// FIXME - op.size == 3
	}
	is 0b1110 then			// STx #+IMM5, MS #+IMM5
	{   tmp = op.rd;
	    if op.L == 0 then
		Write(adr, width, tmp);
	    else
		DoMS(inst, op.rd);
	}
	is 0b1111 then			// STx #-IMM5, MS #-IMM5
	{   tmp = -op.rd;
	    if op.L == 0 then
		Write(adr, width, tmp);
	    else
		DoMS(inst, -op.rd);
	}
	else
	    Fault("Unimplemented instruction", inst);
    }

    proc DoExit(start:_uint, stop:_uint, disp:_uint)
    {   var stack: Addr;
	var F, S, L: boolean;
	var tmp: Word;

	S = (disp & 1) != 0;	// restore saved SP
	F = (disp & 2) != 0;	// use FP not SP for save area
	L = (disp & 4) != 0;	// saved LR to LR, not IP
if db&64 != 0 then {
print bde, "EXIT  start=[d] stop=[d] S=[t] F=[t] L=[t]\n",
start, stop, S, F, L;
}
	if F then
	    stack = reg[FP];
	else
	    stack = reg[SP];
	stack += (disp & ~7);
	loop
	{
	    if start != SP || S then
	    {	tmp = Read(stack, QUAD);
		stack += 8;
		if start == LR && !L then
		    nextpc = tmp;
		else
		    reg[start] = tmp;
	    }
	  exit stop == start;
	    start = (start+1) & 31;
	}
	reg[SP] = stack;
    }


    proc DoEnter(start:_uint, stop:_uint, disp:_uint)
    {   var stack: Addr;
	var F, S: boolean;

	S = (disp & 1) != 0;
	F = (disp & 2) != 0;
if db&64 != 0 then {
print bde, "ENTER start=[d] stop=[d] S=[t] F=[t]\n", start, stop, S, F;
}
	stack = reg[SP];
	loop
	{
	    if stop != SP || S then
	    {	stack -= 8;
		Write(stack, QUAD, reg[stop]);
	    }
	    if stop == FP && F then
		reg[FP] = stack;
	  exit stop == start;
	    stop = (stop-1) & 31;
	}
	reg[SP] = stack - (disp & ~7);
    }

    proc OpMemImm(inst: Inst)
    {   var op: OPMEMIMM = OPMEMIMM(inst);
	var adr: Word;

	adr = Word(_int64(op.imm));	// extend signed 16-bits
	if op.rb == 0 then
	    adr += instpc;
	else
	    adr += reg[op.rb];
if db&2 != 0 then {
print bdx, "adr=[x]\n", adr;
}
	if op.major & 0b001111
	is 0b0000 then		// LDD
	    reg[op.rd] = Read(adr, QUAD);
	is 0b0001 then		// LDUW
	    reg[op.rd] = Read(adr, WORD);
	is 0b0010 then		// LDUH
	    reg[op.rd] = Read(adr, HALF);
	is 0b0011 then		// LDUB
	    reg[op.rd] = Read(adr, BYTE);
	is 0b0100 then
	    DoExit(op.rd, op.rb, op.imm);
	is 0b0101 then		// LDSW
	    reg[op.rd] = Sext(31,Read(adr, WORD));
	is 0b0110 then		// LDSH
	    reg[op.rd] = Sext(15,Read(adr, HALF));
	is 0b0111 then		// LDSB
	    reg[op.rd] = Sext(7,Read(adr, BYTE));
	is 0b1000 then		// STD
	    Write(adr, QUAD, reg[op.rd]);
	is 0b1001 then		// STW
	    Write(adr, WORD, reg[op.rd]);
	is 0b1010 then		// STH
	    Write(adr, HALF, reg[op.rd]);
	is 0b1011 then		// STB
	    Write(adr, BYTE, reg[op.rd]);
	is 0b1100 then
	    DoEnter(op.rd, op.rb, op.imm);
    }

    proc OpBb(inst: Inst)
    {	var op: OPBB = OPBB(inst);
	var n: _uint;
	var src: Word;

	n = op.bit;
	src = reg[op.rs1];
//print bde, "OpBb src=[x] mask=[x]\n", src, (1 << n);
	if src & (1 << n) != 0 then
	{   shadow = 0;
	    nextpc = (Sext(15, inst&0xFFFF) << 2) + instpc;
	}
    }

    proc OpBc(inst: Inst)
    {	var op: OPBC = OPBC(inst);
	var take: boolean;
	var cond: Conditions;
	var tmp: Word;

	tmp = reg[op.rs1];
	cond = Conditions(op.cond);
	if cond
	is EQ0 then take = tmp == 0;
	is NE0 then take = tmp != 0;
	is GE0 then take = SWord(tmp) >= 0;
	is GT0 then take = SWord(tmp) >  0;
	is LE0 then take = SWord(tmp) <= 0;
	is LT0 then take = SWord(tmp) <  0;
/*
	is DEQ then take = _float64(tmp) == 0.0;
	is DNE then take = _float64(tmp) != 0.0;
	is DGE then take = _float64(tmp) >= 0.0;
	is DLT then take = _float64(tmp) <  0.0;
	is DGT then take = _float64(tmp) >  0.0;
	is DLE then take = _float64(tmp) <= 0.0;
	is FEQ then take = _float32(_uint32(tmp)) == 0.0;
	is FNE then take = _float32(_uint32(tmp)) != 0.0;
	is FGE then take = _float32(_uint32(tmp)) >= 0.0;
	is FLT then take = _float32(_uint32(tmp)) <  0.0;
	is FGT then take = _float32(_uint32(tmp)) >  0.0;
	is FLE then take = _float32(_uint32(tmp)) <= 0.0;
*/
	is RET then
	{   nextpc = reg[LR];
	    return;
	}
	is SVC then
	{   SysCall(op.rs1, inst&0xFFFF);
	    return;
	}
	is SVR then Fault("SVR not yet implemented", inst);
	is JTTD, JTTW, JTTH, JTTB then
	{   var optt: OPTT = OPTT(inst);
	    var addr, index, end: Word;
	    var offs: SWord;
	    var size: _uint;

	    index = _min(reg[optt.rs1], optt.imm);
	    size  = optt.size;
	    addr = instpc + 4 + (index << (3 - size));
if db&8 != 0 then {
print bde, "OpJt tablesize=[d] entrysize=[d] table[[[d]]=[x]",
op.imm, size, index, addr;
}
	    if size
	    is 3 then offs = Sext(7,Read(addr, BYTE));
	    is 2 then offs = Sext(15,Read(addr, HALF));
	    is 1 then offs = Sext(31,Read(addr, WORD));
	    is 0 then offs = Read(addr, QUAD);
//	newpc = (addr & ~3) + (offs << 2);	// PC-rel to container address
	    nextpc = instpc + (offs << 2);		// PC-rel to JT inst address
if db&8 != 0 then print bde, " offs=[d] newpc=[x]\n", offs, nextpc;
	    shadow = 0;
	    return;
	}
	else
	    Fault("Unimplemented branch condition instruction", inst);
	if take then
	{   shadow = 0;
	    nextpc = (Sext(15, inst&0xFFFF) << 2) + instpc;
	}
    }


    proc OpBr(inst: Inst)
    {	var op: OPBR = OPBR(inst);

	if (op.major & 1) != 0 then reg[0] = nextpc;
	shadow = 0;
	nextpc = (Sext(25, inst&0x03FF_FFFF) << 2) + instpc;
    }

    proc OpCarry(inst: Inst)
    {	var op: OPCARRY = OPCARRY(inst);

	creg = op.rd;
	cbits = op.imm;
if db&4 != 0 then { print bde, "creg=[d] cbits=[!x]\n", creg, cbits; }
    }

    proc InstrLen(inst: Inst): _uint
    {   var len, major: _uint;

	len = 1;
	if (inst & 0x40) != 0 then	// I bit set
	{
//fde.str("Len I bit set\n");
	    // FIXME - only 2 bits of major needed -01--- or -10---
	    major = inst >> 26;
	    if major
	    is 0b001000, 0b001001,	// XOP0 XOP1
	       0b001011, 0b001101,	// XOP3 XOP5
	       0b001110,		// XOP6
	       0b010001, 0b010010,	// MUX, INS
	       0b010011, 0b010101 then	// MAC LOOP
	    {   len += 1;		// I-bit
		len += (inst >> 5)&1;	// d-bit
	    }
	}
if db&256 != 0 then { print bde, "InstLen=[d]\n", len; }
	return len * 4;	// words to bytes
    }

    // run a single instruction
    proc Run(): boolean
    {
	var inst: Inst;
	var rd, rm, rn, rt: _uint;
	var offs: _int32;	// branch offset
	var imm: _uint64;
	var skip: _uint8;
	var mark: _byte = ':';

	cycles += 1;
	if reg[SP] < stackstat.min then
	{   stackstat.min = reg[SP];
	    stackstat.cycle = cycles;
	}
	fault = NONE;
	instpc = reg[PC];
	inst = Read(instpc, WORD);
	skip = 0;
	if pcnt > 0 then
	{   skip = shadow & 1;
if db&4 != 0 then { print bde, "[x] ", shadow; }
	    shadow = shadow >> 1;
	    pcnt -= 1;
	    if skip != 0 then mark = '!'; else mark = '*';
	}
if db&1 != 0 then {
print bde, "[>8x][c]", instpc, mark;
disInst(instpc);
print bde, "\n";
}
	CI = boolean(cbits&1);
	CO = boolean((cbits>>1)&1);
	cbits = cbits >> 2;
	nextpc = instpc + InstrLen(inst);
	if skip != 0 then
	{   reg[PC] = nextpc;
	    return true;
	}
	if (inst >> 26) & 0b111111
	is 0b000000,
	   0b001111,
	   0b101111, 0b110000 then	// unallocated
	    Fault("Unallocated instruction", inst);
	is MOC_XOM6		then OpPred(inst);
	is MOC_XOM7		then OpPredShf(inst);
	is MOC_XOP0		then OpShfR(inst);
	is MOC_MEM		then OpMem(inst);
	is MOC_INT2		then Op2Int(inst);
	is MOC_FP2		then Op2FP(inst);
	is MOC_OP1		then Op1(inst);
	is MOC_MUX		then OpMux(inst);
	is MOC_INS		then OpIns(inst);
	is MOC_MAC		then OpMac(inst);
	is MOC_LOOP		then OpLoop(inst);
	is MOC_BBIT,MOC_BBIT|1	then OpBb(inst);
	is MOC_BCND		then OpBc(inst);
	is 0b011110..0b011111	then OpBr(inst);
	is 0b100000..0b101100	then OpMemImm(inst); // LD, ST, ENTER, EXIT
	is 0b110001..0b110100	then OpImm(inst); // ADD ... CMP
	is 0b111000..0b111010	then OpImm(inst); // OR .. AND
	is 0b111011		then OpMov(inst);
	is MOC_SHF	        then OpShfOW(inst);
	is MOC_MOD		then OpCarry(inst);
	is MOC_VEC		then OpVec(inst);
	is 0b111111 then	// Syscall hack
	{   if (inst & 0xFFFFFF00) == breakpoint then
		fault = BKPT;
	    else
		Fault("Unallocated instruction", inst);
	}
	else
	    Fault("Unimplemented instruction", inst);
//print bde, "nextpc=[x]\n", nextpc;
	reg[PC] = nextpc;
	return fault == NONE;
    }

    proc DumpMemTab()
    {   var i: _uint;
	print bde, "nsegs=[d]\n", nmem;
	for i from 0 to nmem-1 do
	{
	    print bde, "[x]-[x] @ [p] :",
		memtab[i].beg, memtab[i].end,
		memtab[i].adr;
	    if memtab[i].flg.r then print bde, "r";
	    if memtab[i].flg.w then print bde, "w";
	    if memtab[i].flg.x then print bde, "x";
	    print bde, "\n";
	}
    }


    // ****
    // initialize state using ELF segments
    // ****
    proc Load()
    {   var i, n: _uint;
	var newmem: @MemTab;

	// Determine how man segments ELF loaded
	n = 0;
	for i from 0 to memory.nsegs-1 do
	{	if memory.seg[n].end > memory.seg[n].beg then
		n += 1;
	}
	// Create a new memory table
	// First the segments from ELF
	newmem = _new(MemTab(n+2));
	for i from 0 to n-1 do
	{   newmem[i] = memtab[0];
	    newmem[i].adr = memory.seg[i].mem;
	    newmem[i].beg = memory.seg[i].beg;
	    newmem[i].end = memory.seg[i].end;
	    newmem[i].flg = _uint32(memory.seg[i].flags);
	}
	// The remainder of RAM, must alloc it
	newmem[n] = memtab[0];
	newmem[n].beg = memory.seg[n-1].end + 1;
	newmem[n].adr = sys.malloc(newmem[n].end - newmem[n].beg + 1);
	// The special args area
	newmem[n+1] = memtab[1];
	newmem[n+1].flg = {.r=true};
	memtab = newmem;
	nmem = n+2;
if db > 2 then { DumpMemTab(); }
    }

    // ****
    // chip reset
    // ****
    proc Reset(addr: Addr)
    {
//	reg[PC] = Read(memtab[0].beg+0x18, QUAD);
	reg[PC] = 0;
	reg[SP] = memtab[nmem-2].end+1;
	// FIXME - fake argument list
	reg[1]  = Read(memtab[nmem-1].beg, QUAD);
	reg[2]  = 0x02F0_0008;
	stackstat.min = reg[SP];
	stackstat.max = reg[SP];
    }

    // ****
    // display current register state
    // ****
    proc Dump()
    {
	print bde, "r0-r3    [016x]  [016x]  [016x]  [016x]\n",
	    reg[0],  reg[1],  reg[2],  reg[3];
	print bde, "r4-r7    [016x]  [016x]  [016x]  [016x]\n",
	    reg[4],  reg[5],  reg[6],  reg[7];
	print bde, "r8-r11   [016x]  [016x]  [016x]  [016x]\n",
	    reg[8],  reg[9],  reg[10], reg[11];
	print bde, "r12-r15  [016x]  [016x]  [016x]  [016x]\n",
	    reg[12], reg[13], reg[14], reg[15];
	print bde, "r16-r19  [016x]  [016x]  [016x]  [016x]\n",
	    reg[16], reg[17], reg[18], reg[19];
	print bde, "r20-r23  [016x]  [016x]  [016x]  [016x]\n",
	    reg[20], reg[21], reg[22], reg[23];
	print bde, "r24-r27  [016x]  [016x]  [016x]  [016x]\n",
	    reg[24], reg[25], reg[26], reg[27];
	print bde, "r28-r31  [016x]  [016x]  [016x]  [016x]\n",
	    reg[28], reg[29], reg[30], reg[31];
	print bde, "ip       [016x]  [02x]  [04x]    cycles  [d]\n",
	    reg[PC], shadow, cbits, cycles;
	print bde, "max stack usage [d] bytes at [d] cycles\n",
	    stackstat.max - stackstat.min, stackstat.cycle;
    }


    proc BackTrace()
    {   var fp, ra: Word;

	fp = reg[30];
	while fp > reg[SP] do
	{
	    ra = Read(fp+8, WORD);
	    print bde, "fp=[x] ra=[x]\n", fp, ra;
	    fp = Read(fp, WORD);
	}
    }
}

package chip
{
    const name = "generic";
    const ResetAddress = 0;

    const D: my66000.MemFlags = { .x=true, .w=true, .r=true, .a=true, .l=true };
    var MemTab: []my66000.Mem =
    {
	{ 0, 0x0000_0000, 0x02EF_FFFF, D, 0, 0, 0 },		// RAM
	{ 0, 0x02F0_0000, 0x02F0_0FFF, D, 0, 0, 0 },		// ARGS
    };
    const NSegs = MemTab?len;
    const NELFSegs = 8;

    proc Init(argc: _uint, argv: @[]@[]_byte)
    {   var i, j, k, n: _uint;

	// Stuff for ELF
	memory = pMemory(sys.malloc(Memory?size + NELFSegs*Segment?size));
	memory.nsegs = NELFSegs;
	// Initial memory map for simulator
	my66000.memtab = MemTab;
	my66000.nmem = MemTab?len;
	// generate argument list
	my66000.memtab[1].adr =
	    sys.malloc(my66000.memtab[1].end - my66000.memtab[1].beg + 1);
	const ptrsize = 8;	// size of pointer on target
	my66000.Write(my66000.memtab[1].beg,  QUAD, argc);
	j = ptrsize;		// really size of argc
	k = j + ptrsize * argc;
	for n from 0 to argc-1 do
	{
if db != 0 then { print bde, "argv[[[d]] =[s]\n", n, argv[n]@; }
	    my66000.Write(my66000.memtab[1].beg+j, QUAD, my66000.memtab[1].beg+k);
	    i = 0;
	    loop
	    {   my66000.Write(my66000.memtab[1].beg+k+i,BYTE, argv[n]@[i]);
	      exit argv[n]@[i] == 0;
		i += 1;
	    }
	    k += i+1;
	    j += ptrsize;
	}
    }
}

