// Before importing this, alias <somebd> as bdx.

    proc PReg(reg: _uint)
    {
	print bdx, "[s]", regname[reg];
    }

    proc PAddr(addr: _uint64)
    {
	if _defined(GetSym) then
	{   var s: @[]_byte;
	    s = GetSym(addr);
	    if s != 0 then
	    {	print bdx, "[s]", s;
		return;
	    }
	}
	print bdx, "[!x]", addr;
    }

    proc PWO(wo: Word)
    {
	print bdx, "#[d]", wo&0x3F;	// offset
	if ((wo>>6)&0x3F) != 0 then
	{   print bdx, ",#[d]", (wo>>6)&0x3F;
	}
    }

    proc PFmt(inst: Inst, ip: Word, fmt: @[]_byte)
    {   var i: _uint;
	var c: _byte;
	var op: OP3 = OP3(inst);	// gets all the registers
	var t8: _int8;
	var t16: _int16;
	var dot: boolean = false;
	const Cnd3: [32][2]_byte =
	{   '??', '??', '??', '??', '??', '??', '??',
	    '??', '??', '??', '??', '??', '??',
	    '!=', '> ', '< ',
	    '??', '??', '??', '??', '??', '??', '??',
	    '??', '??', '??', '??', '??', '??',
	    '==', '>=', '<=',
	};
	i = 0;
	loop
	{   c = fmt[i];
	  exit c == 0;
	    if c
	    is '.' then dot = true;
	    is 'C' then print bdx, "[s]", CBitNames[op.rd];
	    is 'D' then print bdx, "[d]", Read(ip+4, HALF);
	    is 'E' then print bdx, "[d]", Read(ip+6, HALF);
	    is 'F' then		// signed I5 in Rs1
	    {   t8 = op.rs1;
		if t8 > 15 then t8 |= ~0xF;
		print bdx, "[d]", t8;
	    }
	    is 'G' then		// signed I5 in Rs2
	    {   t8 = op.rs2;
		if t8 > 15 then t8 |= ~0xF;
		print bdx, "[d]", t8;
	    }
	    is 'H' then		// signed I5 in Rs3
	    {   t8 = op.rs3;
		if t8 > 15 then t8 |= ~0xF;
		print bdx, "[d]", t8;
	    }
	    is 'I' then		// I5 in Rs1
		print bdx, "[d]", op.rs1;
	    is 'J' then		// I5 in Rs2
		print bdx, "[d]", op.rs2;
	    is 'K' then
	    {   t8 = op.rs1;
		print bdx, "[d].[d]", t8/2, (t8&1)*5;
	    }
	    is 'L' then
	    {   t8 = op.rs2;
		print bdx, "[d].[d]", t8/2, (t8&1)*5;
	    }
	    is 'M' then		// optional width for shifts
	    {	if (inst & 0xFC0) != 0 then
		{   print bdx, ",#[d]", (inst >> 6) & 0x3F;
		}
	    }
	    is 'N' then		// offset for shifts
		print bdx, "#[d]", inst & 0x3F;
	    is 'O' then		// #w,#o for insert
		PWO(Word(Read(ip+4, WORD)));
	    is 'P' then		// signed I16 in dec
		print bdx, "[d]", _int16(_uint16(inst));
	    is 'Q' then		// CND in loop
	    {	print bdx, "[c]", Cnd3[op.rd][0];
		if Cnd3[op.rd][1] != ' ' then print bdx, "[c]", Cnd3[op.rd][1];
	    }
	    is 'R' then		// register Rd
		PReg(op.rd);
	    is 'S' then		// register Rs1
		PReg(op.rs1);
	    is 'T' then		// register Rs2
		PReg(op.rs2);
	    is 'U' then		// register Rs3
		PReg(op.rs3);
	    is 'V' then		// unsigned I16 in hex
		print bdx, "[!04x]", _uint16(inst);
	    is 'A' then		// signed I16 in low half
		print bdx, "[d]", _int16(Read(ip+4, WORD));
	    is 'B' then		// signed I16 in high halt
		print bdx, "[d]", _int16(Read(ip+4, WORD)>>16);
	    is 'W' then		// signed I32 but second extension
		print bdx, "[d]", _uint32(Read(ip+8, WORD));
	    is 'X' then		// signed I16 in hex
		print bdx, "[!x]", inst&0xFFFF;
	    is 'Y' then		// signed I32
		print bdx, "[d]", _int32(Read(ip+4, WORD));
	    is 'Z' then		// I64
		print bdx, "[!x]", Read(ip+4, QUAD);
	    else
		print bdx, "[c]", c;
	    i += 1;
	}
    }

    const XXX: []_byte = "???";

    proc disOpMem(inst: Inst, ip: Word)
    {   var op: OPMEM = OPMEM(inst);
	var addr: _uint64;
	var minor: _uint;
	const OpName: [128]@[]_byte =			//   mmmm_L_zz
	{ "ldd",  "lduw", "lduh", "ldub",		// 0b0000_0_zz
	  "lddl", "lduwl","lduhl","ldubl",		// 0b0000_1_zz
	  "la",   "ldsw", "ldsh", "ldsb",		// 0b0001_0_zz
	  XXX,    "ldswl","ldshl","ldsbl",		// 0b0001_1_zz
	  "std",  "stw",  "sth",  "stb",		// 0b0010_0_zz
	  "stdl", "stwl", "sthl", "stbl",		// 0b0010_1_zz
	  "pre",  XXX,    XXX,    XXX,			// 0b0011_0_zz
	  "prel", XXX,    XXX,    XXX,			// 0b0011_1_zz
	  XXX,    XXX,    XXX,    XXX,			// 0b0100_0_zz
	  XXX,    XXX,    XXX,    XXX,			// 0b0100_1_zz
	  XXX,    XXX,    XXX,    XXX,			// 0b0101_0_zz
	  XXX,    XXX,    XXX,    XXX,			// 0b0101_1_zz
	  XXX,    XXX,    XXX,    XXX,			// 0b0110_0_zz
	  XXX,    XXX,    XXX,    XXX,			// 0b0110_1_zz
	  XXX,    XXX,    XXX,    XXX,			// 0b0111_0_zz
	  XXX,    XXX,    XXX,    XXX,			// 0b0111_1_zz
	  XXX,    XXX,    XXX,    XXX,			// 0b1000_0_zz
	  XXX,    XXX,    XXX,    XXX,			// 0b1000_1_zz
	  XXX,    XXX,    XXX,    XXX,			// 0b1001_0_zz
	  XXX,    XXX,    XXX,    XXX,			// 0b1001_1_zz
	  "ldm",  XXX,    XXX,    XXX,			// 0b1010_0_zz
	  XXX,    XXX,    XXX,    "mm",			// 0b1011_1_zz
	  "stm",  XXX,    XXX,    XXX,			// 0b1011_0_zz
	  XXX,    XXX,    XXX,    "ms",			// 0b1100_1_zz
	  XXX,    XXX,    XXX,    XXX,			// 0b1100_0_zz
	  XXX,    XXX,    XXX,    XXX,			// 0b1100_1_zz
	  XXX,    XXX,    XXX,    XXX,			// 0b1101_0_zz
	  XXX,    XXX,    XXX,    XXX,			// 0b1101_1_zz
	  "std",  "stw",  "sth",  "stb",		// 0b1110_0_zz
	  XXX,    XXX,    XXX,    "ms",			// 0b1110_1_zz
	  "std",  "stw",  "sth",  "stb",		// 0b1111_0_zz
	  XXX,    XXX,    XXX,    "ms",			// 0b1111_1_zz
	};
	var name: @[]_byte;

	minor = op.minor;
	if minor == 0b0111 then	// the misc instructions
	{   if op.rd
	    is 0 then
	    {	if op.L == 0 then
		    name = "jmpa";
		else
		    name = "jmpx";
	    }
	    is 1 then
	    {	if op.L == 0 then
		    name = "cala";
		else
		    name = "calx";
	    }
	    else
		name = XXX;
	}
	else
	    name = OpName[(inst >> 9) & 0b1111_1_11];

	print bdx, "[s]\t", name;
	if minor
	is 0b0000, 0b0001, 0b0010, 0b0011 then	// normal load/store
	{   PReg(op.rd);
	    print bdx, ",";
	}
	is 0b1010, 0b1011 then
	{   if op.L == 0 then	// ldm, stm
	    {	PReg(op.rd); print bdx, ",";
		PReg(op.ri); print bdx, ",";
		op.ri = 0;	// defeat indexing
	    }
	    else		// mm, ms
	    {	PReg(op.rb); print bdx, ",";
		PReg(op.rd); print bdx, ",";
		if op.I == 0 then
		{   if op.D == 0 then
			PReg(op.ri);
		    else
			print bdx, "#[d]", op.ri;
		}
		else
		{   if op.D == 0 then
			print bdx, "#[d]", Read(ip+4, WORD);
		    else
			print bdx, "#[!x]", Read(ip+4, QUAD);
		}
		return;
	    }
	}
	is 0b1110, 0b1111 then
	{   if op.L == 0 then	// store IMM5
	    {
		if op.minor == 0b1110 then	// +IMM5
		    print bdx, "#[d],", op.rd;
		else
		    print bdx, "#-[d],",  op.rd;
	    }
	    else		// ms
	    {	PReg(op.rb); print bdx, ",";
		if op.minor == 0b1110 then	// +IMM5
		    print bdx, "#[d],", op.rd;
		else
		    print bdx, "#-[d],",  op.rd;
		if op.I == 0 then
		{   if op.D == 0 then
			PReg(op.ri);
		    else
			print bdx, "#[d]", op.ri;
		}
		else
		{   if op.D == 0 then
			print bdx, "#[d]", Read(ip+4, WORD);
		    else
			print bdx, "#[!x]", Read(ip+4, QUAD);
		}
		return;
	    }
	}
	// address syntax follows
	print bdx, "[[";
	if op.rb == 0 then PReg(32); else PReg(op.rb);
	if op.ri != 0 then
	{   print bdx, ",";
	    PReg(op.ri);
	    if op.sc != 0 then
		print bdx, "<<[d]", op.sc;
	}
	if op.I != 0 then
	{   if op.D == 0 then	// 32-bit
	    {   addr = _int32(Read(ip+4, WORD));
		print bdx, ",[d]", _int32(addr);
	    }
	    else
	    {   addr = Read(ip+4, QUAD);
		print bdx, ",[!x]", addr;
	    }
	}
	print bdx, "]";

    }

    proc disOp2Int(inst: Inst, ip: Word)
    {   var op: OP2 = OP2(inst);
	var minor: _uint;;
	const OpName: [128]@[]_byte =
	{ XXX,     XXX,     XXX,     XXX,	// 0000_0_zz
	  XXX,     XXX,     XXX,     XXX,	// 0000_1_zz
	  "add",   "addw",  XXX,     XXX,	// 0001_0_zz
	  "adds",  "addws", XXX,     XXX,	// 0001_1_zz
	  "mul",   "mulw",  XXX,     XXX,	// 0010_0_zz
	  "muls",  "mulws", XXX,     XXX,	// 0010_1_zz
	  "div",   "divw",  XXX,     XXX,	// 0011_0_zz
	  "divs",  "divws", XXX,     XXX,	// 0011_1_zz
	  "cmp",   "cmpw",  XXX,     XXX,	// 0100_0_zz
	  "???",   XXX,     XXX,     XXX,	// 0100_1_zz
	  "???",   XXX,     XXX,     XXX,	// 0101_0_zz
	  "???",   XXX,     XXX,     XXX,	// 0101_1_zz
	  "max",   "maxw",  XXX,     XXX,	// 0110_0_zz
	  "maxs",  "maxws", XXX,     XXX,	// 0110_1_zz
	  "min",   "minw",  XXX,     XXX,	// 0111_0_zz
	  "mins",  "minws", XXX,     XXX,	// 0111_1_zz
	  "or",    "orw",   XXX,     XXX,	// 1000_0_zz
	  "???",   XXX,     XXX,     XXX,	// 1000_1_zz
	  "xor",   "xorw",  XXX,     XXX,	// 1001_0_zz
	  "???",   XXX,     XXX,     XXX,	// 1001_1_zz
	  "and",   "andw",  XXX,     XXX,	// 1010_0_zz
	  XXX,     XXX,     XXX,     XXX,   	// 1010_1_zz
	  XXX,     XXX,     XXX,     XXX,	// 1011_0_zz
	  XXX,     XXX,     XXX,     XXX,  	// 1011_1_zz
	  XXX,     XXX,     XXX,     XXX,	// 1100_0_zz
	  XXX,     XXX,     XXX,     XXX,  	// 1100_1_zz
	  XXX,     XXX,     XXX,     XXX,	// 1101_0_zz
	  XXX,     XXX,     XXX,     XXX,  	// 1101_1_zz
	  "cvtfu", XXX,     XXX,     XXX,	// 1110_0_zz
	  "cvtfs", XXX,     XXX,     XXX,	// 1110_1_zz
	  "cvtdu", XXX,     XXX,     XXX,	// 1111_0_zz
	  "cvtds", XXX,     XXX,     XXX,	// 1111_1_zz
	};
	const OpFmt: [16]@[]_byte =	// s1.s2.I.D
	{   "R,S,T",  "R,S,#J", "R,S,#Y", "R,S,#Z",	// 00ID
	    "R,S,-T", "R,#I,T", "R,#Y,T", "R,#Z,T",	// 01ID
	    "R,-S,T", "R,S,#-J","R,-S,#Y","R,-S,#Z",	// 10ID
	    "R,-S,-T","R,#I,-T","R,#Y,-T","R,#Z,-T"	// 11ID
	};
	minor = (inst >> 9) & 0b1111_1_11;
//fde.str("disOp2Int minor="); fde.uint(minor);
//fde.str(" nnId="); fde.hex8((inst >> 5)&0b1111);
//fde.str(" name="); fde.str(OpName[minor]);
//fde.str(" fmt="); fde.str(OpFmt[(inst >> 5)&0b1111]); fde.nl();
	{   print bdx, "[s]\t", OpName[minor];
	    PFmt(inst, ip, OpFmt[(inst >> 5)&0b1111]);
	}
    }

    proc disOp2FP(inst: Inst, ip: Word)
    {   var op: OP2 = OP2(inst);
	var minor: _uint;
	const OpName: [128]@[]_byte =
	{ XXX,     XXX,     XXX,     XXX,   	// 0000_0_zz
	  XXX,     XXX,     XXX,     XXX,	// 0000_1_zz
	  XXX,     XXX,     XXX,     XXX,	// 0001_0_zz
	  "fadd",  "faddf", XXX,     XXX,	// 0001_1_zz
	  XXX,     XXX,     XXX,     XXX,	// 0010_0_zz
	  "fmul",  "fmulf", XXX,     XXX,	// 0010_1_zz
	  XXX,     XXX,     XXX,     XXX,	// 0011_0_zz
	  "fdiv",  "fdivf", XXX,     XXX,	// 0011_1_zz
	  XXX,     XXX,     XXX,     XXX,	// 0100_0_zz
	  "fcmp",  "fcmpf", XXX,     XXX,	// 0100_1_zz
	  XXX,     XXX,     XXX,     XXX,	// 0101_0_zz
	  XXX,     XXX,     XXX,     XXX,	// 0101_1_zz
	  XXX,     XXX,     XXX,     XXX,	// 0110_0_zz
	  "fmax",  "fmaxf", XXX,     XXX,	// 0110_1_zz
	  XXX,     XXX,     XXX,     XXX,	// 0111_0_zz
	  "fmin",  "fminf", XXX,     XXX,	// 0111_1_zz
	  "rnd",   "cvtfd", XXX,     XXX,	// 1000_0_zz
	  "csgn",  "csgnf", XXX,     XXX,	// 1000_1_zz
	  "cvtdf", "rndf",  XXX,     XXX,	// 1001_0_zz
	  "eadd",  "eaddf", XXX,     XXX,	// 1001_1_zz
	  XXX,     XXX,     XXX,     XXX,	// 1010_0_zz
	  XXX,     XXX,     XXX,     XXX,	// 1010_1_zz
	  XXX,     XXX,     XXX,     XXX,	// 1011_0_zz
	  XXX,     XXX,     XXX,     XXX,	// 1011_1_zz
	  "cvtdu", "cvtfu", XXX,     XXX,	// 1100_0_zz
	  XXX,     XXX,     XXX,     XXX,	// 1100_1_zz
	  "cvtds", "cvtfs", XXX,     XXX,	// 1101_0_zz
	  "hypot", "hypotf",XXX,     XXX,	// 1101_1_zz
	  "cvtud", "cvtuf", XXX,     XXX,	// 1110_0_zz
	  "pow",   "powf",  XXX,     XXX,	// 1110_1_zz
	  "cvtsd", "cvtsf", XXX,     XXX,	// 1111_0_zz
	  "atan2", "atan2f",XXX,     XXX,	// 1111_1_zz
	};
	const OpFmt: [16]@[]_byte =	// s1.s2.I.D
	{   "R,S,T",  "R,S,#L", "R,S,#Y", "R,S,#Z",	// 00ID
	    "R,S,-T", "R,#K,T", "R,#Y,T", "R,#Z,T",	// 01ID
	    "R,-S,T", "R,S,#-L","R,-S,#Y","R,-S,#Z",	// 10ID
	    "R,-S,-T","R,#K,-T","R,#Y,-T","R,#Z,-T"	// 11ID
	};
	minor = (inst >> 9) & 0b1111_1_11;
	var iscvt: boolean;
	iscvt = (minor & 0b1000_1_00) == 0b1000_0_00;
//print bde, "disOp2FP minor=[07b], iscvt=[t]\n", minor, iscvt;
	{   print bdx, "[s]\t", OpName[minor];
	    PFmt(inst, ip, OpFmt[(inst >> 5)&0b1111]);
	}
    }

    proc disOp3(inst: Inst, ip: Word)
    {   var op: OP3 = OP3(inst);
	const OpFmt: [16]@[]_byte =	// s1.s2.I.D
	{   "R,U,S,T",  "R,U,S,#J", "R,U,S,#Y", "R,U,S,#Z",	// 00ID
	    "R,U,S,-T", "R,U,#I,T", "R,U,#Y,T", "R,U,#Z,T",	// 01ID
	    "R,U,-S,T", "R,U,S,#-J","R,U,-S,#Y","R,U,-S,#Z",	// 10ID
	    "R,U,-S,-T","R,U,#I,-T","R,U,#Y,-T","R,U,#Z,-T"	// 11ID
	};
	const OpFmt2: [8]@[]_byte =
	{   "R,S,T,U",   "R,S,T,-U",  "R,S,-T,U",  "R,S,-T,-U",
	    "R,S,T,#Y",  "R,S,#Y,U",  "R,S,T,#Z",  "R,S,#Z,U"
	};
	const OpFmt3: [16]@[]_byte =	// s1.s2.I.D
	{   "R,U,S,T",  "R,U,S,#J", "R,U,S,MN", "R,U,S,#Z",	// 00ID
	    "R,U,S,-T", "R,U,#I,T", "R,U,#Y,T", "R,U,#Z,T",	// 01ID
	    "R,U,-S,T", "R,U,S,#-J","R,U,-S,MN","R,U,-S,#Z",	// 10ID
	    "R,U,-S,-T","R,U,#I,-T","R,U,#Y,-T","R,U,#Z,-T"	// 11ID
	};

//print bde, "disOp3 major [6b]\n", op.major;
	if op.major
	is MOC_MUX then		// the varieties of MUX
	{   print bdx, "cmov\t";
	    PFmt(inst, ip, OpFmt[(inst>>5)&0b1111]);
	}
	is MOC_MAC then	// FMAC
	{   if op.size == 0 then
		print bdx, "fmac\t";
	    else if op.size == 1 then
		print bdx, "fmacf\t";
	    PFmt(inst, ip, OpFmt[(inst>>5)&0b1111]);
	}
	is MOC_INS then	// INS
	{   print bdx, "ins\t";
	    PFmt(inst, ip, OpFmt3[(inst>>5)&0b1111]);
	}
	else
	    print bdx, "???";
    }

    proc disOp1(inst: Inst, ip: Word)
    {   var op: OP1 = OP1(inst);
	const OpName: [64]@[]_byte =
	{ "hr",  "vec", "???", "???", "???", "???", "expon", "fract",
	  "pop", "ff1", "???", "???", "???", "???", "???", "???",
	  "cvt", "cvt", "???", "???", "rnd", "???", "???", "???",
	  "???", "???", "???", "???", "???", "???", "???", "???"
	};
	const OpFF1Name: [4]@[]_byte =
	{ "clz", "fl1", "ft1", "ctz" };
	const TransName: [32]@[]_byte =
	{ "fln2",   "fln",  "flog",      "???",
	  "fexp2",  "fexp", "fexp10",    "???",
	  "frcp",   "???",   "???",      "???",
	  "frsqrt", "fsqrt", "???",      "???",
	  "fln2p1", "flnp1", "flogp1",   "???",
	  "fexp2m1","fexpm1","fexp10m1", "???",
	  "fsin",   "fcos",  "ftan",     "???",
	  "fasin",  "facos", "fatan",    "???"
	};
	const HRFunc: [32]_byte =
	{ 'I', 'M', 'A', 'E', 'S', 'F', 'R', 'W',
	  '?', '?', '?', '?', '?', '?', '?', '?',
	  '?', '?', '?', '?', '?', '?', '?', '?',
	  '?', '?', '?', '?', '?', '?', '?', '?'
	};
	if op.minor
	is 0b0000 then				// HR
	{   print bdx, "hr";
	    if op.size&1 != 0 then
	    {   if op.size&2 != 0 then
		    print bdx, "x\t";
		else
		    print bdx, "r\t";
		PReg(op.rd);
	    }
	    if op.size&2 != 0 then
	    {   if op.size&1 == 0 then
		    print bdx, "w\t";
		else
		    print bdx, ",";
		PReg(op.rs2);
	    }
	    print bdx, ",[c]", HRFunc[op.func];
	}
	is 0b0001 then		// VEC
	{	var reg: _uint;
	    var mask: _uint32;
	    mask = _uint32(Read(ip+4, WORD));
	    print bdx, "vec\t"; PReg(op.rd);
	    print bdx, ",{";
	    if mask != 0 then
	    {   loop
		{   reg = _ctz(mask);
		    PReg(reg);
		    mask &= ~(1 << reg);
		  exit mask == 0;
		    print bdx, ",";
		}
	    }
	    print bdx, "}";
	    return;
	}
	else
	{   const OpFmt: [16]@[]_byte =	// s1.s2.I.D
	    {   "R,T",  "R,#J",   "R,#Y",   "R,#Z",	// 00ID
		"R,-T", "R,#I,T", "R,#Y,T", "R,#Z,T",	// 01ID
		"R,T",  "R,#-J",  "R,#Y",   "R,#Z",	// 10ID
		"R,-T", "R,-T",   "R,-T",   "R,-T"	// 11ID
	    };
	    if op.minor
	    is 0b1000 then
	    {	if op.func
		is 0b00000 then
		{   if op.S == 0 then print bdx, "mov";
				 else print bdx, "abs";
		}
		is 0b00001 then
		{   print bdx, "fabs";
		    if op.size != 0 then print bdx, "f";
		}
		is 0b00010 then
		{   print bdx, "expon";
		    if op.size != 0 then print bdx, "f";
		}
		is 0b00011 then
		{   print bdx, "fract";
		    if op.size != 0 then print bdx, "f";
		}
		else print bdx, "???";
	    }
	    is 0b0110 then		// FF1 family
	    {	if op.func <= 4 then print bdx, "[s]", OpFF1Name[op.func];
		else print bdx, "???";
	    }
	    is 0b0111 then		// POP
		print bdx, "[s]", OpName[op.minor];
	    is 0b11000 then		// TRANS
	    {   print bdx, "[s]", TransName[op.func];
		if op.S != 0 then print bdx, "f";
	    }
	    print bdx, "\t";
	    PFmt(inst, ip, OpFmt[(inst >> 5)&0b1111]);	// nnID
	}
    }

    proc PShadow(e: _uint, t: _uint)
    {
	while t > 0 do
	{   print bdx, "T";
	    t -= 1;
	}
	while e > 0 do
	{   print bdx, "F";
	    e -= 1;
	}
    }

    proc disShfR(inst: Inst, ip: Word)
    {	var op: OPSHFR = OPSHFR(inst);
	const ShfROpNames: [16]@[]_byte =
	{   "???", "???", "???", "???",
	    "???", "???", "rol", "ror",
	    "srl", "sra", "sll", "sla",
	    "bitr","???", "???", "???"
	};
	const OpFmt: [16]@[]_byte =	// s1.s2.I.D
	{   "R,S,T",  "R,S,#J", "R,S,#Y", "R,S,#Z",	// 00ID
	    "R,S,-T", "R,#I,T", "R,#Y,T", "R,#Z,T",	// 01ID
	    "R,-S,T", "R,S,#-J","R,-S,#Y","R,-S,#Z",	// 10ID
	    "R,-S,-T","R,#I,-T","R,#Y,-T","R,#Z,-T"	// 11ID
	};
	print bdx, "[s]\t", ShfROpNames[op.minor];
	PFmt(inst, ip, OpFmt[(inst >> 5)&0b1111]);
    }

    proc disShfW(inst: Inst, ip: Word)
    {	var op: OPSHF = OPSHF(inst);
	const ShfROpNames: [16]@[]_byte =
	{   "???", "???", "???", "???",
	    "???", "???", "rol", "ror",
	    "srl", "sra", "sll", "sla",
	    "bitr","???", "???", "???"
	};
	print bdx, "[s]\t", ShfROpNames[op.minor];
	PFmt(inst, ip, "R,S,NM");
    }

    proc disPred(inst: Inst, ip: Word)
    {   var opc: OPPC = OPPC(inst);	// assume pred on condition

	if opc.minor
	is 0b0000 then	// pred on bit
	{   var opb: OPPB = OPPB(inst);
	    print bdx, "p[s]\t", CBitNames[opb.bit];
	    PReg(opb.rs1); print bdx, ",";
	    PShadow(opb.else, opb.then);
	    print bdx, "\t; bit [d]", opb.bit;
	}
	is 0b0001 then
	{   print bdx, "p[s]\t", CondNames[opc.cond];
	    PReg(opc.rs1); print bdx, ",";
	    PShadow(opc.else, opc.then);
	}
	else print bdx, "???";
    }

    proc disPredShf(inst: Inst, ip: Word)
    {	var op: OPSHF = OPSHF(inst);
	const ShfOpNames: [16]@[]_byte =
	{   "???", "???", "???", "???",
	    "bitr","???", "rol", "ror",
	    "srl", "sra", "sll", "sla",
	    "ror", "rol", "???", "???"
	};

	if op.minor
	is 0b0000 then
	    disPred(inst, ip);
	else
	{
	    print bdx, "[s]\t", ShfOpNames[op.minor];
	    PFmt(inst, ip, "R,S,N");
	}
    }

    proc disOpBb(inst: Inst, ip: Word)
    {	var op: OPBB = OPBB(inst);
	var adr: Word;

	print bdx, "b[s]\t", CBitNames[op.bit];
	PReg(op.rs1); print bdx, ",";
	adr = Word(Sext(15, inst&0xFFFF)) << 2;
	adr += ip;
	print bdx, "[!x]", _uint32(adr);
    }

    proc disOpBc(inst: Inst, ip: Word)
    {	var op: OPBC = OPBC(inst);
	var adr: Word;

	if Conditions(op.cond)
	is RET then print bdx, "ret";
	is SVC then
	{   print bdx, "svc\t";
	    PFmt(inst, ip, "#I,#P");
	}
	is SVR then
	{   print bdx, "svr\t";
	    PFmt(inst, ip, "#I");
	}
	is JTTD, JTTW, JTTH, JTTB then
	{   var optt: OPTT = OPTT(inst);
	    const size: [4]_byte = { 'd', 'w', 'h', 'b' };
	    print bdx, "jtt[c]\t", size[optt.size];
	    PReg(op.rs1);
	    print bdx, ",#[d]", optt.imm;
	}
	else
	{   print bdx, "b[s]\t", CondNames[op.cond];
	    PReg(op.rs1);
	    adr = Word(Sext(15, inst&0xFFFF)) << 2;
	    adr += ip;
	    print bdx, ",[!x]", _uint32(adr);
	}
    }

    proc disOpBfc(inst: Inst, ip: Word)
    {	var op: OPBC = OPBC(inst);
	var adr: Word;

	print bdx, "b[s]\t", FCondNames[op.cond];
	PReg(op.rs1);
	adr = Word(Sext(15, inst&0xFFFF)) << 2;
	adr += ip;
	print bdx, ",[!x]", _uint32(adr);
    }

    proc disOpBr(inst: Inst, ip: Word)
    {	var op: OPBR = OPBR(inst);
	var adr: Word;

	if (op.major & 1) != 0 then print bdx, "call\t";
			       else print bdx, "br\t";
	adr = ip + Word(Sext(25, inst&0x03FF_FFFF) << 2);
	print bdx, "[!x]\t;", _uint32(adr);
	PAddr(adr);
    }

    proc disOpMemImm(inst: Inst, ip: Word)
    {   var op: OPMEMIMM = OPMEMIMM(inst);
	const OpName: [16]@[]_byte =
	{ "ldd" , "lduw","lduh","ldub",
	  "exit", "ldsw","ldsh","ldsb",
	  "std",  "stw", "sth", "stb",
	  "enter","???", "???", "???"
	};

	print bdx, "[s]\t", OpName[op.major&0b1111];
	PReg(op.rd); print bdx, ",";
	if op.major&0b1111
	is 0b0100, 0b1100 then	// exit, enter
	{   PReg(op.rb);
	    print bdx, ",[d],[d]", op.imm & 0xFFF8, op.imm & 7;
	}
	else
	{   print bdx, "[[";
	    if op.rb == 0 then PReg(32); else PReg(op.rb);
	    print bdx, ",[d]]", _int16(op.imm);
	}
    }


    proc disOpImm(inst: Inst, ip: Word)
    {	var op: OPIMM = OPIMM(inst);
	const OpName: [16]@[]_byte =
	{ "???", "add", "mul", "div", "cmp", "???", "???", "???",
	  "or",  "xor", "and", "mov", "???", "???", "???", "???"
	};
	const MovName: [4]@[]_byte =
	{ "movd",  "movf", "movh", "mov"
	};
	const OpFmt = "R,S,#P\t; X";
	const OpMovs = "R,#P\t; X";
	const OpMovu = "R,#V\t; X";

	if op.major&0b1111 == 0b1011 then	// MOV
	{   print bdx, "[s]\t", MovName[(op.rs1>>3)&0b11];
	    if op.rs1 == 0b11000 then
		PFmt(inst, ip, OpMovs);
	    else
		PFmt(inst, ip, OpMovu);
	}
	else
	{   print bdx, "[s]\t", OpName[op.major&0b1111];
	    PFmt(inst, ip, OpFmt);
	}
    }

    proc disLoop(inst: Inst, ip: Word)
    {   var op: OPLOOP = OPLOOP(inst);
	var cmp: @[]_byte;
	var cnd, kind, nnId: _uint;

	const Cnd: [10]@[]_byte =
	{   "eq",  "ne", "hs",  "lo",  "hi",  "ls",	// unsigned
	    "ge",  "lt",  "gt", "le"			// signed
	};
	const OpFmt: [16]@[]_byte =
	{   "R,S,T",   "R,S,#G",  "R,S,#Y", "R,S,#Z",	// 00xx
	    "?0100",   "R,#F,T",  "R,#Y,T", "R,#Z,T",	// 01xx
	    "?1000",   "?1001",   "?1010",  "?1011",	// 10xx
	    "?1100",   "R,#F,#G", "R,#B,#A","R,#W,#Y"	// 11xx
	};

	kind = (op.kcnd / 11) + 1;
	cnd = op.kcnd % 11;
	nnId = (inst >> 5)&0b1111;
	print bdx, "loop[d]\t[s],", kind, Cnd[cnd];
//	print bdx, " [[[04b]] ", nnId;
	PFmt(inst, ip, OpFmt[nnId]);

    }

   proc disCarry(inst: Inst, ip: Word)
    {	var op: OPCARRY = OPCARRY(inst);
	var bits: _uint;

	print bdx, "carry\t";
	PReg(op.rd); print bdx, ",{";
	bits = op.imm;
	while (bits != 0) do
	{ if bits & 3
	  is 0 then print bdx, "-";
	  is 1 then print bdx, "I";
	  is 2 then print bdx, "O";
	  is 3 then print bdx, "IO";
	  bits = bits >> 2;
	  if bits != 0 then print bdx, ",";
	}
	print bdx, "}";
    }

    proc disVec(inst: Inst, ip: Word)
    {	var op: OPVEC = OPVEC(inst);
	var bits, tmp: _uint;
	var reg: _uint;

	print bdx, "vec\t";
	tmp = op.imm;
	bits = ((tmp & 0x1F8000) << 10) |
	       ((tmp & 0x007FFF) << 1);
	PReg(op.rd); print bdx, ",{";
	if bits != 0 then
	{   loop
	    {   reg = _ctz(bits);
		PReg(reg);
		bits &= ~(1 << reg);
	      exit bits == 0;
		print bdx, ",";
	    }
	}
	print bdx, "}";
    }


    proc InstLen(inst: Inst): _uint
    {   var len, major: _uint;

	len = 1;
	if (inst & 0x40) != 0 then	// I bit set
	{
//fde.str("Len I bit set\n");
	    // FIXME - only 2 bits of major needed -01--- or -10---
	    major = inst >> 26;
	    if major
	    is MOC_XOP0, MOC_INT2,	// XOP0 XOP1
	       MOC_FP2,  MOC_MEM,	// XOP3 XOP5
	       MOC_OP1,			// XOP6
	       MOC_MUX,  MOC_INS,	// MUX, INS
	       MOC_MAC,  MOC_LOOP then	// MAC LOOP
	    {   len += 1;		// I-bit
		len += (inst >> 5)&1;	// d-bit
	    }
	}
	return len * 4;	// words to bytes
    }

    proc disInst(ip: Addr): _uint
    {	var n, i: _uint;
	var inst: Inst;
	var major: 0..0b111111;

	inst = Read(ip, WORD);
	major = (inst >> 26) & 0b111111;
	n = InstLen(inst);
	print bdx, " [08x]\t", Read(ip, WORD);
	if major
	is MOC_XOM6           then disPred(inst, ip);
	is MOC_XOM7           then disPredShf(inst, ip);
	is MOC_XOP0	      then disShfR(inst, ip);
	is MOC_INT2           then disOp2Int(inst, ip);
	is MOC_FP2            then disOp2FP(inst, ip);
	is MOC_MEM	      then disOpMem(inst, ip);
	is MOC_OP1	      then disOp1(inst, ip);
	is MOC_MUX	      then disOp3(inst, ip);
	is MOC_INS	      then disOp3(inst, ip);
	is MOC_MAC	      then disOp3(inst, ip);
	is MOC_LOOP	      then disLoop(inst, ip);
	is MOC_BBIT,MOC_BBIT|1 then disOpBb(inst, ip);
	is MOC_BCND	      then disOpBc(inst, ip);
	is MOC_BFCND	      then disOpBfc(inst, ip);
	is 0b011110..0b011111 then disOpBr(inst, ip);
	is 0b100000..0b100110 then disOpMemImm(inst, ip); // LD
	is 0b101000..0b101011 then disOpMemImm(inst, ip); // ST
	is 0b100111, 0b101100 then disOpMemImm(inst, ip); // ENTER, EXIT
	is 0b110001..0b110100,
	   0b111000..0b111011 then disOpImm(inst, ip);
	is MOC_SHF	      then disShfW(inst, ip);
	is 0b111100	      then disCarry(inst, ip);
	is 0b111101           then disVec(inst, ip);
	is 0b111111 then	// Syscall hack
	{   if inst == 0xFFAA5501 then
		print bdx, "<syscall>";
	    elif (inst & 0xFFFFFF00) == 0xFFAA0000 then
		print bdx, "<breakpoint>";
	    else
		print bdx, "Unimplemented instruction [08x]", inst;
	}
	else
	    print bdx, "Unimplemented instruction [08x]", inst;
	i = 4;
	while i < n do
	{   print bdx, "\n          [08x]", Read(ip+i, WORD);
	    i += 4;
	}
	bdx.flush();
	return n;
    }
