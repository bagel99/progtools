    type  Inst: _uint32;	// size of an instruction
    type  Addr: _uint64;	// size of an address
    type  Word: _uint64;	// register, unsigned
    type  SWord: _int64;	// register, signed
    type REG: 0..31;

    // Major opcode
    const MOC_XOM6 = 0b000110;
    const MOC_XOM7 = 0b000111;
    const MOC_XOP0 = 0b001000;
    const MOC_INT2 = 0b001001;
    const MOC_FP2  = 0b001011;
    const MOC_MEM  = 0b001101;
    const MOC_OP1  = 0b001110;
    const MOC_MUX  = 0b010001;
    const MOC_INS  = 0b010010;
    const MOC_MAC  = 0b010011;
    const MOC_LOOP = 0b010101;
    const MOC_BBIT = 0b011000;	// also 0b011001
    const MOC_BCND = 0b011010;	// integer, also JTT
    const MOC_BFCND= 0b011011;	// float
    const MOC_EXIT = 0b100100;
    const MOC_ENTER= 0b101100;
    const MOC_MOV  = 0b111011;
    const MOC_SHF  = 0b110101;
    const MOC_MOD  = 0b111100;
    const MOC_VEC  = 0b111101;

    type OPMEM:
    {	major:	0..0b111111;	// 31..26
	rd:	REG;		// 25..21
	rb:	REG;		// 20..16
	minor:  0..0b1111;	// 15..12
	L:	0..1;		// 11
	size:   0..0b11;	// 10..9
	sc:	0..0b11;	// 8..7
	I:	0..1;		// 6
	D:	0..1;		// 5
	ri:	REG;		// 4..0
    }: packed, msb, bits(32);

    type OP2:
    {	major:	0..0b111111;	// 31..26
	rd:	REG;		// 25..21
	rs1:	REG;		// 20..16
	minor:  0..0b1111;	// 15..12
	S:	0..1;		// 11
	size:   0..0b11;	// 10..9
	s1:	0..1;		// 8
	s2:	0..1;		// 7
	I:	0..1;		// 6
	D:	0..1;		// 5
	rs2:	REG;		// 4..0
    }: packed, msb, bits(32);

    type OP1:
    {	major:	0..0b111111;	// 31..26
	rd:	REG;		// 25..21
	func:	0..0b11111;	// 20..16
	minor:  0..0b1111;	// 15..12
	S:	0..1;		// 11
	size:   0..0b11;	// 10..9
	s1:	0..1;		// 8
	s2:	0..1;		// 7
	I:	0..1;		// 6
	D:	0..1;		// 5
	rs2:	REG;		// 4..0
    }: packed, msb, bits(32);

    type OP3:
    {	major:	0..0b111111;	// 31..26
	rd:	REG;		// 25..21
	rs1:	REG;		// 20..16
	rs3:	REG;		// 15..11
	size:   0..0b11;	// 10..9
	s1:	0..1;		// 8
	s2:	0..1;		// 7
	I:	0..1;		// 6
	D:	0..1;		// 5
	rs2:	REG;		// 4..0
    }: packed, msb, bits(32);

    type OPSHF:
    {	major:	0..0b111111;	// 31..26
	rd:	REG;		// 25..21
	rs1:	REG;		// 20..16
	minor:	0..0b1111;	// 15..12
	w:	0..0b111111;	// 11..6;
	o:	0..0b111111;	// 5..0
    }: packed, msb, bits(32);

    type OPSHFR:	// XOM7
    {	major:	0..0b111111;	// 31..26
	rd:	REG;		// 25..21
	rs1:	REG;		// 20..16
	minor:	0..0b1111;	// 15..12
	S:	0..1;		// 11
	size:   0..0b11;	// 10..9
	s1:	0..1;		// 8
	s2:	0..1;		// 7
	_:	0..1;		// 6
	o:	0..0b111111;	// 5..0
    }: packed, msb, bits(32);

    type OPLOOP:
    {	major:	0..0b111111;	// 31..26
	rd:	REG;		// 25..21
	rs1:	REG;		// 20..16
	kcnd:	0..0b11111;	// 15..11 kind and cnd
	size:   0..0b11;	// 10..9
	s1:	0..1;		// 8
	s2:	0..1;		// 7
	I:	0..1;		// 6
	D:	0..1;		// 5
	rs2:	REG;		// 4..0
    }: packed, msb, bits(32);

    type OPCARRY:
    {	major:	0..0b111111;	// 31..26
	rd:	REG;		// 25..21
	func:	0..0b11111;	// 20..16
	imm:	_int16;		// 15..0
    }: packed, msb, bits(32);

    type OPVEC:
    {	major:	0..0b111111;	// 31..26
	rd:	REG;		// 25..21
	imm:    0..0x1FFFFF;	// 20..0
    }: packed, msb, bits(32);

    type OPIMM:
    {	major:	0..0b111111;	// 31..26
	rd:	REG;		// 25..21
	rs1:	REG;		// 20..16
	imm:   _int16;		// 15..0
    }: packed, msb, bits(32);

    type OPMEMIMM:
    {	major:	0..0b111111;	// 31..26
	rd:	REG;		// 25..21
	rb:	REG;		// 20..16
	imm:	_int16;		// 15..0
    }: packed, msb, bits(32);

    type OPBR:
    {	major:	0..0b111111;	// 31..26
	offset: 0..0x3FFFFF;	// 25..0 - sign extend << 2
    }: packed, msb, bits(32);

    type OPBC:
    {	major:	0..0b111111;	// 31..26
	cond:	0..31;		// 25..21
	rs1:	REG;		// 20..16
	imm:   _int16;		// 15..0 - sign extend << 2
    }: packed, msb, bits(32);

    type OPTT:	// This is a variation of OPBC
    {	major:	0..0b111111;	// 31..26
	ones:	0..0b111;	// 25..23 should be 0b111
	size:   0..0b11;	// 22..21
	rs1:	REG;		// 20..16
	imm:	_uint16;	// 15..0
    }: packed, msb, bits(32);

    type OPBB:
    {	major:	0..0b11111;	// 31..27
	bit:	0..63;		// 26..21 - extends into major
	rs1:	REG;		// 20..16
	offset: _int16;		// 15..0 - sign extend << 2
    }: packed, msb, bits(32);

    type OPPC:
    {	major:	0..0b111111;	// 31..26
	cond:	0..31;		// 25..21
	rs1:	REG;		// 20..16
	minor:	0..0b1111;	// 15..12
	_:      0..0b11;	// 11..10
	else:	0..0b1111;	// 9..6
	_:      0..0b11;	// 5..4
	then:   0..0b1111;	// 3..0
    }: packed, msb, bits(32);

    type OPPB:
    {	major:	0..0b11111;	// 31..27
	bit:	0..63;		// 26..21 - extends into major
	rs1:	REG;		// 20..16
	minor:	0..0b1111;	// 15..12
	_:      0..0b11;	// 11..10
	else:	0..0b1111;	// 9..6
	_:      0..0b11;	// 5..4
	then:   0..0b1111;	// 3..0
    }: packed, msb, bits(32);



    type Conditions:	// for BCND (integer)
    (	EQ0, NE0, GE0, LT0, GT0, LE0, A,   N,
	_,   _,   _,   _,   _,   _,   _,   _,
	_,   _,   IN, RET,  _,   _,   SVC, SVR,
	_,   _,   _,   _,   JTTD,JTTW,JTTH,JTTB
    );
    const CondNames: [Conditions][5]_byte =
    {	"eq0", "ne0", "ge0", "lt0", "gt0", "le0", "a",   "n",
	"",    "",    "",    "",    "",    "",    "",    "",
	"",    "",    "in",  "ret", "",    "",    "svr", "svc",
	"",    "",    "",    "",    "jttd","jttw","jtth","jttb"
    };
    type FConditions:	// for BFCND
    (	DEQ, DNE, DGE, DLT, DGT, DLE, DOR, DUN,		// double
	FEQ, FNE, FGE, FLT, FGT, FLE, FOR, FUN,		// single
	_,   _,   _,   _,   _,   _,   _,   _,
	_,   _,   _,   _,   _,   _,   _,   _
    );
    const FCondNames: [Conditions][5]_byte =
    {	"deq", "dne", "dge", "dlt", "dgt", "dle", "dor", "dun",
	"feq", "fne", "fge", "flt", "fgt", "fle", "for", "fun",
	"",    "",    "",    "",    "",    "",    "",    "",
	"",    "",    "",    "",    "",    "",    "",    ""
    };
    type CBits:		// result of CMP or FCMP
    (	EQ=0, NEQ, NE, NNE, GE, NGE, LT, NLT,		// 0-7
	GT=8, NGT, LE, NLE, HS, LO,  HI, LS,		// 8-15
	OR=16, NOR, TO, NTO,				// 16-23
	SIN=24, FIN, CIN, RIN, NaN=31,			// 24-31
	SNaN=32, QNaN, NI, NN, ND, NZ, PZ, PD, PN, PI,	// 32-41
	_=63
    );
    const CBitNames: [CBits][5]_byte =
    {   "eq",  "neq", "ne",  "nne", "ge",  "nge", "lt",  "nlt",	// 0-7
	"gt",  "ngt", "le",  "nle", "hs",  "lo",  "hi",  "ls",	// 8-15
	"or",  "nor", "to",  "nto", "??",  "??",  "??",  "??",	// 16-23
	"sin", "fin", "cin", "rin", "??",  "??",  "??",  "??",	// 24-31
	"snan","qnan","minf","mnor","mde", "mze", "pze", "pde",	// 32-39
	"??",  "??",  "??",  "??",  "??",  "??",  "??",  "??",	// 40-47
	"??",  "??",  "??",  "??",  "??",  "??",  "??",  "??",	// 48-55
	"??",  "??",  "??",  "??",  "??",  "??",  "??",  "??"	// 56-63
    };
    type RoundingModes:
    (	NE,	// nearest even
	NO,	// nearest odd
	NM,	// nearest magnitude
	_,	// unused
	AZ,	// away from zero
	TZ,	// towards zero
	PI,	// towards + infinity
	NI,	// towards - infinity
	CM	// current mode
    );

    const regname: [33]@[]_byte =
    {	"r0",	"r1",	"r2",	"r3",	"r4",	"r5",	"r6",	"r7",
	"r8",	"r9",	"r10",	"r11",	"r12",	"r13",	"r14",	"r15",
	"r16",	"r17",	"r18",	"r19",	"r20",	"r21",	"r22",	"r23",
	"r24",	"r25",	"r26",	"r27",	"r28",	"r29",	"r30",	"sp",
	"ip"
    };
