
package parse
{
    const db: boolean = false;
    alias lex.SkipWS as SkipWS;
    alias lex.Symbol as GetSym;
    alias expr.Expr0 as Expr;
    alias segment.curseg as curseg;

    proc CheckComma(s: @[]_byte): @[]_byte
    {
	s = SkipWS(s);
	if s[0] != ',' then
	    return 0;
	s = SkipWS(s[1:]);
	return s;
    }

    proc SkipComma(s: @[]_byte): @[]_byte
    {   var r: @[]_byte;

	r = CheckComma(s);
	if r == 0 then
	{   Syntax("',' expected");
	    return s;
	}
	return r;
    }

    proc ScanComma(s: @[]_byte, term: _byte): @[]_byte
    {
	loop
	{ exit s[0] == ',';
	  exit s[0] == '\n' || s[0] == term with s = 0;
	    s = s[1:];
	}
	return s;
    }

    proc TryReg(s: @[]_byte): @[]_byte, _uint
    {
	if s[0] == 'r' then
	{   if s[1]
	    is '1' then
	    {	if s[2]
	    	is '0'..'9' then
	    	    return s[3:], s[2] - '0' + 10;
	    	else
	    	    return s[2:], 1;
	    }
	    is '2' then
	    {	if s[2]
	    	is '0'..'9' then
	    	    return s[3:], s[2] - '0' + 20;
	    	else
	    	    return s[2:], 2;
	    }
	    is '3' then
	    {	if s[2]
	    	is '0'..'1' then
	    	    return s[3:], s[2] - '0' + 30;
	    	else
	    	    return s[2:], 3;
	    }
	    is '0', '4'..'9' then
	    	return s[2:], s[1] - '0';
	}
	elif s[0] == 's' && s[1] == 'p' then return s[2:], 31;
	elif s[0] == 'i' && s[1] == 'p' then return s[2:], 32;
	return s[0:], 0;
    }

    proc GetReg(s: @[]_byte): @[]_byte, _uint
    {   var reg: _uint;
	var r: @[]_byte;

	r, reg = TryReg(s);
	if r == s then
{
	    Syntax("register expected");
print bde, "[!s]\n", 16, r;
}
	return r, reg;
    }

    proc GetBaseReg(s: @[]_byte): @[]_byte, _uint
    {   var reg: _uint;

         s, reg = GetReg(s);
	 if reg == 32 then reg = 0;	// ip as base register
	 return s, reg;
    }

    proc IsImm5(x: _int64): boolean
    {
	return x >= -31 && x <= 31;
    }

    proc IsSImm5(x: _int64): boolean
    {
	return x >= -16 && x <= 15;
    }

    proc IsImm16(x: _int64): boolean
    {
	return x >= _int16?min && x <= _int16?max;
    }

    proc IsImm32(x: _int64): boolean
    {
	return x >= _int32?min && x <= _int32?max;
    }

    type OperandForm: (REG, REGN, IMM5P, IMM5N, IMM32, IMM64);

    type OperandT:
    {   type:   OperandForm;
	reg:    _uint8;
	fixup:  boolean;
	expr:   expr.ExprT;
    };

    const OperandName: [OperandForm]@[]_byte =
    { "REG", "REGN", "IMM5P", "IMM5N", "IMM32", "IMM64" };

    proc GetOperand(s: @[]_byte, o: @OperandT): @[]_byte
    {
	o.fixup  = false;
	if s[0] == '#' then
	{   s = Expr(s[1:], o.expr);
	    if o.expr.op == NONE then
	    {	if IsImm5(o.expr.offs) then
		{   if o.expr.offs < 0 then
		    {   o.expr.offs =- o.expr.offs;
			o.type = IMM5N;
		    }
		    else
			o.type = IMM5P;
		}
		elif IsImm32(o.expr.offs) then
		    o.type = IMM32;
		else
		    o.type = IMM64;
	    }
	    else
	    {   if fixlong then o.type = IMM64;
		else o.type = IMM32;
		o.fixup = true;
	    }
	    o.reg = 0;
	}
	else
	{   o.type = REG;
	    if s[0] == '-' then
	    {	o.type = REGN;
		s = SkipWS(s[1:]);
	    }
	    s, o.reg = GetReg(s);
	}
	return s;
    }

    /*
     * Map 2 operands into nnID
     * -IMM5,REG => IMM32,REG,   -IMM5,-REG => IMM32,-REG
     * -REG,+IMM5 => -REG,IMM32, -REG,-IMM5 => -REG,IMM32
     */
    const FmtTab:[OperandForm][OperandForm]_int8 =
    { //  REG      REGN      IMM5P     IMM5N     IMM32     IMM64
      { 0b0_0000, 0b0_0100, 0b0_0001, 0b1_1001, 0b0_0010, 0b0_0011 },  // REG
      { 0b0_1000, 0b0_1100, 0b0_1010, 0b1_1010, 0b0_1010, 0b0_1011 },  // REGN
      { 0b0_0101, 0b0_1101,     -1,       -1,       -1,       -1   },  // IMM5P
      { 0b1_0110, 0b1_1110,     -1,       -1,       -1,       -1   },  // IMM5N
      { 0b0_0110, 0b0_1110,     -1,       -1,       -1,       -1   },  // IMM32
      { 0b0_0111, 0b0_1111,     -1,       -1,       -1,       -1   }   // IMM64
    };

    proc getFormat2(o1: @OperandT, o2: @OperandT): _uint, boolean
    {	var tmp: _int8;
	tmp = FmtTab[o1.type][o2.type];
	if tmp < 0 then
	    Syntax("Two immediates not allowed");
	return _uint(tmp&0b1111), (tmp>>4) != 0;
    }

    proc getFormat1(o2: @OperandT): _uint, boolean
    {	var tmp: _int8;
	tmp = FmtTab[REG][o2.type];
	if tmp < 0 then
	    Syntax("Two immediates not allowed");
	return _uint(tmp&0b1111), (tmp>>4) != 0;
    }

import my66000def;

    const CondNames4: [Conditions][4]_byte =
    {	'eq0', 'ne0', 'ge0', 'lt0', 'gt0', 'le0', "a",   "n",
	'deq', 'dne', 'dge', 'dlt', 'dgt', 'dle', 'dor', 'dun',
	'feq', 'fne', 'fge', 'flt', 'fgt', 'fle', 'for', 'fun',
	'in',  "",    "",    "",    "",    "",    'rfe', 'ret'
    };

    proc GetCond(s: @[]_byte): @[]_byte, _uint
    {   var r:  @[]_byte;
	var n: _uint;
	var cond: [4]_byte;

	r = s;
	s, n = lex.Symbol(s);
	if s == r then	// not a symbol
	{   Syntax("Expecting branch condition");
	    return r, 0;
	}
	cond[0:n] = r[0:n];
	while n < 4 do
	{   cond[n] = 0;
	    n += 1;
	}
//print bde, "GetCond='[!s]'\n", 4, cond;
	// search for condition name
	n = 0;
	while n <= 31 && cond != CondNames4[n] do
	    n += 1;
	if n > 31 then
	{   Syntax("Unknown branch condition");
	    return r, 0;
	}
	return s, n;
    }

