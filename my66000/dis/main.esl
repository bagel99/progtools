import sys;
const fdi: sys.fildes = 0;
import out;
alias out.fdo as fdo;
alias out.fde as fde;

import prt;
var bde: fmt.pDesc;
var bdo: fmt.pDesc;
alias bdo as bdx;

import elfread64;

import my66000def;

type  Width: (BYTE, HALF, WORD, QUAD);

    // Sign extend from a bit, leave as unsigned
    proc Sext(bit: _uint, x: Word): Word: inline
    {   var tmp: SWord;

	tmp = SWord(x);
	tmp = tmp << (Word?bits-1 - bit);
	tmp = tmp >> (Word?bits-1 - bit);
	return Word(tmp);
    }

// This is only going to access the current text section
var curtxt: elfread.pText;
proc Read(addr: Addr, w: Width): Word
{   var offs: _uint;
    var rv: Word;

    offs = addr - curtxt.addr;
    if offs >= curtxt.size then
    {	// FIXME - error
	return 0;
    }
    if w
    is BYTE then rv = curtxt.txt[offs];
    is HALF then rv = _unpkle(curtxt.txt[offs:2]);
    is WORD then rv = _unpkle(curtxt.txt[offs:4]);
    is QUAD then rv = _unpkle(curtxt.txt[offs:8]);
    return rv;
}

// Stuff to support print symbols at the correct place
// Fixme, the symbols should be sorted

var pstr: elfread.pStrings;
var psym: elfread.pSymbols;

proc NextSym(start: Addr)(addr: Addr, name:  @[]_byte)
{   var i: _uint;
    var sinx: _uint;

    addr = addr?max;
    name = 0;
    i = 0;
    while i < psym.num do
    {
	if psym.sym[i].value >= start then
	{   addr = psym.sym[i].value;
	    sinx = psym.sym[i].name;
	    name = pstr.str[sinx:];
	    return;
	}
	i += 1;
    }
}

proc SortSymbols()
{
}

// FIXME - this is very inefficient to call for every instruction
proc GetSym(addr: Addr): @[]_byte
{   var i: _uint;
    var sinx: _uint;

    i = 0;
    while i < psym.num do
    {
	if psym.sym[i].value == addr then
	{   sinx = psym.sym[i].name;
	    return pstr.str[sinx:];
	}
	i += 1;
    }
    return 0;
}

import disinst;

proc DisSection(ptxt: elfread.pText)
{   var i: _uint;
    var addr, end, symaddr: Addr;
    var symname: @[]_byte;
    var inst: Inst;
    var newsym: boolean = true;

    curtxt = ptxt;
    addr = ptxt.addr;
    end = addr + ptxt.size;
    while addr < end do
    {   /*
	if newsym then
	{   symaddr, symname = NextSym(addr);
	    newsym = false;
	}
	if addr == symaddr then
	{   print bdx, "[s]:\n", symname;  // FIXME
	    newsym = true;
	}
	*/
	symname = GetSym(addr);
	if symname != 0 then print bdx, "[s]:\n", symname;
	print bdx, "[>8x] ", _uint32(addr);
	inst = Read(addr, WORD);
	addr += disInst(addr);
	// Check for inline jump table, was previous inst a JT
	if (inst & 0xFF80_0000) == 0x6B80_0000 then
	{   var op: OPTT = OPTT(inst);
	    var j, n: _uint;
	    n = op.imm;
	    if op.size
	    is 3 then
	    {	for j from 0 to n do
		{   if (j & 7) == 0 then
			print bdx, "\n\t\t\t.jt8\t";
		    else
			print bdx, ",";
		    print bdx, "[d]", _int8(Read(addr, BYTE));
		    addr += 1;
		}
	    }
	    is 2 then
	    {	for j from 0 to n do
		{   if (j & 7) == 0 then
			print bdx, "\n\t\t\t.jt16\t";
		    else
			print bdx, ",";
		    print bdx, "[d]", _int16(Read(addr, HALF));
		    addr += 2;
		}
	    }
	    is 1 then
	    {	for j from 0 to n do
		{   if (j & 7) == 0 then
			print bdx, "\n\t\t\t.jt32\t";
		    else
			print bdx, ",";
		    print bdx, "[d]", _int32(Read(addr, WORD));
		    addr += 4;
		}
	    }
	    is 0 then {}	// FIXME
	    addr = (addr + 3) & ~3;	// round end of table up
	}
	print bdx, "\n";
    }
}

proc main(argc:_uint, argv:@[]@[]_byte):_int //[[global]]
{
    var fd: sys.fildes;
    var i: _uint;

    i = 1;
    if i >= argc then
	return 1;
    bdo = prt.open(prt.fdo, 512);
    bde = prt.open(prt.fde, 128);
    bde.setflush(true);
    fd = sys.open(argv[i]@, {RDONLY}, 0);
    if fd < 0 then
    {   print bde, "Unable to open [s]\n", argv[i]@;
	return 1;
    }
    var pf: elfread.pFile;
    var ptxt: elfread.pText;
    var nshdr: _uint;

    pf = elfread.Init(fd, MY66000);
    if pf == 0 then
    {   print bde, "Unable to process\n";
	return 2;
    }
    nshdr = pf.fh.shnum;
print bde, "nshdr=[d]\n", nshdr;
    psym, pstr = pf.GetSymbols();
//DumpSym();

    i = 0;
    loop
    { exit i >= nshdr;
	ptxt, i = pf.GetNextTextSection(i);
      exit ptxt == 0;
	DisSection(ptxt);
	i += 1;
    }
    prt.close(bdo);
    return 0;
}

